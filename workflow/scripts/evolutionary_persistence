#!/usr/bin/env python3
"""Evolutionary persistence — coherence decay along graph walks.

Measures the spatial extent over which evolutionary history is conserved
as you walk outward from a unitig in the compacted colored de Bruijn graph.

Reports two coherence metrics at each hop distance:

- **Strict coherence**: fraction of reached unitigs with the same
  cut-string as the seed (integer index equality).
- **Ancestor-descendant coherence**: fraction where one cut-string's
  assignment is in an ancestor-descendant-or-equal relationship with the
  other's on the phylogenetic tree.  This captures unitigs that share a
  primary evolutionary event but differ in secondary refinements.

Each metric has its own null expectation (constant across hops):

- Strict null = Simpson index: Σ fᵢ².
- Anc/desc null = Σ_{(i,j) coherent} fᵢ·fⱼ, estimated by sampling
  when the number of unique cut-strings is large.

The gap between the two curves quantifies how much of the pangenome
has been secondarily modified after initial acquisition.

Output
------
TSV with columns:

    hop_distance  n_pairs  n_strict_coherent  n_ancdesc_coherent
    strict_coherence  ancdesc_coherence  null_strict  null_ancdesc
"""

from __future__ import annotations

import argparse
import multiprocessing as mp
import sqlite3
import sys
import time
from collections import defaultdict
from itertools import permutations
from pathlib import Path
from typing import Dict, FrozenSet, List, Sequence, Tuple

import numpy as np

try:
    from ete4 import Tree
except ImportError:
    from ete3 import Tree

try:
    from loguru import logger
except ImportError:
    import logging
    logger = logging.getLogger(__name__)


# ---------------------------------------------------------------------------
# Logger
# ---------------------------------------------------------------------------

def _configure_logger(verbosity: int) -> None:
    """0 → WARNING, 1 → INFO, 2+ → DEBUG."""
    try:
        from loguru import logger as _lg
        _lg.remove()
        level = "WARNING" if verbosity == 0 else (
            "INFO" if verbosity == 1 else "DEBUG")
        _lg.add(sys.stderr, level=level)
    except ImportError:
        import logging
        level = (logging.WARNING if verbosity == 0
                 else logging.INFO if verbosity == 1
                 else logging.DEBUG)
        logging.basicConfig(level=level, stream=sys.stderr)


# ---------------------------------------------------------------------------
# Cut-string parsing
# ---------------------------------------------------------------------------

def _parse_cutstring(cs: str) -> List[FrozenSet[str]]:
    """Parse a cut-string into a list of alternative solution sets.

    Rules:
        "NodeA"             → [{NodeA}]
        "NodeA,NodeB"       → [{NodeA, NodeB}]
        "NodeA OR NodeB,NodeC" → [{NodeA}, {NodeB, NodeC}]
    """
    if not cs or cs == "None":
        return [frozenset({"__UNASSIGNED__"})]
    alternatives = cs.split(" OR ")
    solutions = []
    for alt in alternatives:
        nodes = frozenset(n.strip() for n in alt.split(",") if n.strip())
        solutions.append(nodes)
    return solutions


# ---------------------------------------------------------------------------
# Tree: Euler tour for O(1) ancestor-descendant queries
# ---------------------------------------------------------------------------

def _build_euler_tour(
    tree: Tree,
) -> Tuple[np.ndarray, np.ndarray, Dict[str, int]]:
    """Euler-tour entry/exit times for O(1) ancestor-descendant queries.

    Returns:
        entry  -- int32 array indexed by node index, DFS entry time
        exit_  -- int32 array indexed by node index, DFS exit time
        name_to_nidx -- mapping from node name to index
    """
    named_nodes = sorted({n.name for n in tree.traverse() if n.name})
    name_to_nidx = {n: i for i, n in enumerate(named_nodes)}
    N = len(name_to_nidx)

    entry = np.zeros(N, dtype=np.int32)
    exit_ = np.zeros(N, dtype=np.int32)

    clock = 0
    stack: List[Tuple[Tree, bool]] = [(tree, False)]
    while stack:
        node, leaving = stack.pop()
        if leaving:
            if node.name and node.name in name_to_nidx:
                exit_[name_to_nidx[node.name]] = clock
            clock += 1
        else:
            if node.name and node.name in name_to_nidx:
                entry[name_to_nidx[node.name]] = clock
            clock += 1
            stack.append((node, True))
            for child in reversed(node.children):
                stack.append((child, False))

    return entry, exit_, name_to_nidx


# ---------------------------------------------------------------------------
# Ancestor-descendant concordance check
# ---------------------------------------------------------------------------

def _is_anc_or_desc(
    a: int, b: int,
    entry: np.ndarray, exit_: np.ndarray,
) -> bool:
    """O(1) ancestor-or-descendant check via Euler-tour times."""
    return ((entry[a] <= entry[b] and exit_[b] <= exit_[a]) or
            (entry[b] <= entry[a] and exit_[a] <= exit_[b]))


def _concordance_check(
    sols_a: List[FrozenSet[str]],
    sols_b: List[FrozenSet[str]],
    entry: np.ndarray,
    exit_: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> bool:
    """True if any pair of alternative solutions has a concordant matching.

    A concordant matching is an injective mapping from the smaller set into
    the larger where every mapped pair is in an ancestor-descendant-or-equal
    relationship on the tree.
    """
    for sa in sols_a:
        for sb in sols_b:
            if _injective_ancdesc_match(sa, sb, entry, exit_, name_to_nidx):
                return True
    return False


def _injective_ancdesc_match(
    set_a: FrozenSet[str],
    set_b: FrozenSet[str],
    entry: np.ndarray,
    exit_: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> bool:
    """Check if an injective anc/desc matching exists from smaller into larger."""
    idx_a = [name_to_nidx[n] for n in set_a if n in name_to_nidx]
    idx_b = [name_to_nidx[n] for n in set_b if n in name_to_nidx]
    if not idx_a or not idx_b:
        return False

    if len(idx_a) > len(idx_b):
        idx_a, idx_b = idx_b, idx_a

    # Single vs single/multi: O(1) or O(|larger|)
    if len(idx_a) == 1:
        a = idx_a[0]
        return any(_is_anc_or_desc(a, b, entry, exit_) for b in idx_b)

    # Multi vs multi: brute-force injective matchings (sets are tiny, 2-4 nodes)
    for perm in permutations(idx_b, len(idx_a)):
        if all(_is_anc_or_desc(idx_a[i], perm[i], entry, exit_)
               for i in range(len(idx_a))):
            return True
    return False


# ---------------------------------------------------------------------------
# Graph loading
# ---------------------------------------------------------------------------

def _load_graph_and_colors(
    db_path: Path,
) -> Tuple[Dict[str, List[str]], Dict[str, str]]:
    """Load adjacency list and cut-string assignments from SQLite.

    Returns:
        adj    -- adj[uid] = list of neighbor uids (undirected)
        colors -- colors[uid] = raw cut-string (or "None")
    """
    conn = sqlite3.connect(db_path)

    # Adjacency → undirected
    adj: Dict[str, List[str]] = defaultdict(list)
    for uid, _, nid, _ in conn.execute(
        "SELECT unitig_id, unitig_direction, "
        "neighbor_id, neighbor_direction FROM adjacency"
    ):
        adj[uid].append(nid)
        adj[nid].append(uid)

    # Cut-strings
    colors: Dict[str, str] = {}
    for uid, cs in conn.execute("SELECT unitig_id, colors FROM unitigs"):
        colors[uid] = cs if cs else "None"

    conn.close()

    # Ensure every unitig in colors has an adjacency entry (isolated nodes)
    for uid in colors:
        if uid not in adj:
            adj[uid] = []

    logger.info(
        "Graph loaded: {:,} unitigs, {:,} undirected adjacency entries",
        len(colors), sum(len(v) for v in adj.values()))
    return dict(adj), colors


# ---------------------------------------------------------------------------
# Integer-indexed CSR graph for fast BFS
# ---------------------------------------------------------------------------

def _build_csr_graph(
    adj: Dict[str, List[str]],
    colors: Dict[str, str],
) -> Tuple[List[str], Dict[str, int], np.ndarray, np.ndarray]:
    """Convert string-keyed graph to integer-indexed CSR arrays.

    Eliminates hash lookups in the BFS hot loop.

    Returns:
        unitig_list   -- sorted list of unitig IDs
        uid_to_int    -- mapping from unitig ID to integer index
        csr_offsets   -- int64 array [N+1], row pointers into csr_neighbors
        csr_neighbors -- int32 array, concatenated neighbor indices
    """
    unitig_list = sorted(colors.keys())
    uid_to_int = {uid: i for i, uid in enumerate(unitig_list)}
    N = len(unitig_list)

    offsets = np.zeros(N + 1, dtype=np.int64)
    nb_list: List[int] = []
    for i, uid in enumerate(unitig_list):
        nbs = adj.get(uid, [])
        nb_list.extend(uid_to_int[nb] for nb in nbs)
        offsets[i + 1] = len(nb_list)

    csr_neighbors = (
        np.array(nb_list, dtype=np.int32)
        if nb_list else np.empty(0, dtype=np.int32))

    logger.info(
        "CSR graph: {:,} nodes, {:,} directed entries",
        N, len(csr_neighbors))
    return unitig_list, uid_to_int, offsets, csr_neighbors


# ---------------------------------------------------------------------------
# Precompute coherence lookup (top-K approach)
# ---------------------------------------------------------------------------

def _build_concordance_table(
    colors: Dict[str, str],
    entry: np.ndarray,
    exit_: np.ndarray,
    tree_name_to_nidx: Dict[str, int],
) -> Tuple[
    List[str], Dict[str, int],
    np.ndarray | None, set | None, List[int] | None, Dict[int, int] | None,
    List[List[FrozenSet[str]]], np.ndarray,
]:
    """Build concordance table for the top-K most frequent cut-strings.

    Strategy:
    - Find the K most frequent cut-string indices covering ~90% of unitigs.
    - Precompute concordance for all K×K pairs (stored as K×K bool matrix).
    - For pairs involving rare cut-strings, fall back to on-the-fly checks.

    Returns:
        unique_cuts      -- list of M unique cut-strings
        cut_to_idx       -- mapping from cut-string to index
        concordance_table -- K×K bool array (or M×M if M is small), or None
        top_k_set        -- set of top-K global indices (None if full table)
        top_k_list       -- sorted list of top-K global indices (None if full)
        top_k_to_local   -- global index → local index in concordance_table
        parsed_cuts      -- parsed form of each unique cut-string
        simple_nidx      -- int32 array [M], tree node index for simple
                            cut-strings (-1 if not simple)
    """
    cut_counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        cut_counts[cs] += 1

    unique_cuts = list(cut_counts.keys())
    cut_to_idx = {cs: i for i, cs in enumerate(unique_cuts)}
    M = len(unique_cuts)

    logger.info("Unique cut-strings: {:,}", M)

    parsed_cuts = [_parse_cutstring(cs) for cs in unique_cuts]

    # Build simple_nidx: tree node index for simple (single-node) cut-strings
    simple_nidx = np.full(M, -1, dtype=np.int32)
    for i, p in enumerate(parsed_cuts):
        if (len(p) == 1 and len(p[0]) == 1
                and "__UNASSIGNED__" not in p[0]):
            node_name = next(iter(p[0]))
            nidx = tree_name_to_nidx.get(node_name)
            if nidx is not None:
                simple_nidx[i] = nidx

    n_simple = int((simple_nidx >= 0).sum())
    logger.info(
        "Simple cut-strings: {:,}/{:,} ({:.1f}%)",
        n_simple, M, 100.0 * n_simple / max(M, 1))

    # If M is small enough, build the full M×M table
    if M <= 50_000:
        concordance_table = np.eye(M, dtype=np.bool_)
        t0 = time.time()
        for i in range(M):
            for j in range(i + 1, M):
                # Fast path for simple vs simple
                if simple_nidx[i] >= 0 and simple_nidx[j] >= 0:
                    if _is_anc_or_desc(simple_nidx[i], simple_nidx[j],
                                       entry, exit_):
                        concordance_table[i, j] = True
                        concordance_table[j, i] = True
                elif _concordance_check(parsed_cuts[i], parsed_cuts[j],
                                        entry, exit_, tree_name_to_nidx):
                    concordance_table[i, j] = True
                    concordance_table[j, i] = True
        elapsed = time.time() - t0
        n_concordant = int(concordance_table.sum()) - M
        logger.info(
            "Full concordance table built in {:.1f}s: {:,} coherent pairs "
            "(of {:,} off-diagonal)",
            elapsed, n_concordant // 2, M * (M - 1) // 2)
        return (unique_cuts, cut_to_idx, concordance_table,
                None, None, None, parsed_cuts, simple_nidx)

    # Large M: build top-K table covering ~90% of unitigs
    total = sum(cut_counts.values())
    sorted_by_freq = sorted(
        range(M), key=lambda i: cut_counts[unique_cuts[i]], reverse=True)

    cumsum = 0
    top_k_list: List[int] = []
    for idx in sorted_by_freq:
        cumsum += cut_counts[unique_cuts[idx]]
        top_k_list.append(idx)
        if cumsum >= 0.9 * total:
            break

    top_k_list.sort()
    top_k_set = set(top_k_list)
    top_k_to_local = {g: l for l, g in enumerate(top_k_list)}
    K = len(top_k_list)

    logger.info(
        "Top-K concordance: K={:,} covers {:.1f}% of {:,} unitigs",
        K, 100.0 * cumsum / total, total)

    concordance_table = np.eye(K, dtype=np.bool_)
    t0 = time.time()
    for i_local in range(K):
        i_global = top_k_list[i_local]
        for j_local in range(i_local + 1, K):
            j_global = top_k_list[j_local]
            # Fast path for simple vs simple
            if simple_nidx[i_global] >= 0 and simple_nidx[j_global] >= 0:
                if _is_anc_or_desc(simple_nidx[i_global], simple_nidx[j_global],
                                   entry, exit_):
                    concordance_table[i_local, j_local] = True
                    concordance_table[j_local, i_local] = True
            elif _concordance_check(parsed_cuts[i_global], parsed_cuts[j_global],
                                    entry, exit_, tree_name_to_nidx):
                concordance_table[i_local, j_local] = True
                concordance_table[j_local, i_local] = True
    elapsed = time.time() - t0
    n_concordant = int(concordance_table.sum()) - K
    logger.info(
        "Top-K concordance table built in {:.1f}s: {:,} coherent pairs",
        elapsed, n_concordant // 2)

    return (unique_cuts, cut_to_idx, concordance_table,
            top_k_set, top_k_list, top_k_to_local, parsed_cuts, simple_nidx)


# ---------------------------------------------------------------------------
# BFS coherence measurement
# ---------------------------------------------------------------------------

def _bfs_coherence(
    seed_int: int,
    csr_offsets: np.ndarray,
    csr_neighbors: np.ndarray,
    cut_idx_array: np.ndarray,
    n_unitigs: int,
    max_hops: int,
    concordance_table: np.ndarray | None,
    parsed_cuts: List[List[FrozenSet[str]]],
    simple_nidx: np.ndarray,
    top_k_set: set | None,
    top_k_to_local: Dict[int, int] | None,
    entry: np.ndarray,
    exit_: np.ndarray,
    tree_name_to_nidx: Dict[str, int],
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """BFS from *seed_int* up to *max_hops*, counting concordant neighbours.

    Returns three int arrays of length max_hops (index 0 = hop 1):
        n_reached           -- total unitigs reached at each hop distance
        n_strict_concordant -- strict equality (index identity)
        n_ancdesc_concordant -- ancestor-descendant matches
    """
    seed_cidx = cut_idx_array[seed_int]
    n_reached = np.zeros(max_hops, dtype=np.int64)
    n_strict = np.zeros(max_hops, dtype=np.int64)
    n_ancdesc = np.zeros(max_hops, dtype=np.int64)

    # Determine seed's concordance lookup strategy
    use_full_table = (top_k_set is None and concordance_table is not None)
    seed_in_topk = (top_k_set is not None and seed_cidx in top_k_set)

    if use_full_table:
        seed_concordance_row = concordance_table[seed_cidx]
    elif seed_in_topk:
        seed_local = top_k_to_local[seed_cidx]
        seed_concordance_row = concordance_table[seed_local]
    else:
        seed_concordance_row = None

    seed_parsed = parsed_cuts[seed_cidx]
    seed_snidx = simple_nidx[seed_cidx]  # -1 if not simple

    visited = np.zeros(n_unitigs, dtype=np.bool_)
    visited[seed_int] = True
    frontier = [seed_int]

    for h in range(max_hops):
        next_frontier: List[int] = []
        for uid_int in frontier:
            start = csr_offsets[uid_int]
            end = csr_offsets[uid_int + 1]
            for j in range(start, end):
                nb_int = csr_neighbors[j]
                if not visited[nb_int]:
                    visited[nb_int] = True
                    next_frontier.append(nb_int)
                    n_reached[h] += 1
                    nb_cidx = cut_idx_array[nb_int]

                    if nb_cidx == seed_cidx:
                        n_strict[h] += 1
                        n_ancdesc[h] += 1
                    elif use_full_table:
                        # Full M×M table available
                        if seed_concordance_row[nb_cidx]:
                            n_ancdesc[h] += 1
                    elif seed_in_topk and top_k_set is not None and nb_cidx in top_k_set:
                        # Both in top-K: use precomputed table
                        nb_local = top_k_to_local[nb_cidx]
                        if seed_concordance_row[nb_local]:
                            n_ancdesc[h] += 1
                    else:
                        # Fall back to on-the-fly check
                        nb_snidx = simple_nidx[nb_cidx]
                        if seed_snidx >= 0 and nb_snidx >= 0:
                            # Both simple: O(1) ancestor-descendant check
                            if _is_anc_or_desc(seed_snidx, nb_snidx,
                                               entry, exit_):
                                n_ancdesc[h] += 1
                        elif _concordance_check(
                                seed_parsed, parsed_cuts[nb_cidx],
                                entry, exit_, tree_name_to_nidx):
                            n_ancdesc[h] += 1

        frontier = next_frontier
        if not frontier:
            break

    return n_reached, n_strict, n_ancdesc


# ---------------------------------------------------------------------------
# Shared state for fork-based multiprocessing
# ---------------------------------------------------------------------------

_SHARED: Dict = {}


def _worker_bfs(args_tuple):
    """Process a batch of seeds.  Reads shared data from _SHARED."""
    seed_ints, worker_id = args_tuple
    csr_offsets = _SHARED["csr_offsets"]
    csr_neighbors = _SHARED["csr_neighbors"]
    cut_idx_array = _SHARED["cut_idx_array"]
    n_unitigs = _SHARED["n_unitigs"]
    max_hops = _SHARED["max_hops"]
    concordance_table = _SHARED["concordance_table"]
    parsed_cuts = _SHARED["parsed_cuts"]
    simple_nidx = _SHARED["simple_nidx"]
    top_k_set = _SHARED["top_k_set"]
    top_k_to_local = _SHARED["top_k_to_local"]
    entry = _SHARED["entry"]
    exit_ = _SHARED["exit_"]
    tree_name_to_nidx = _SHARED["tree_name_to_nidx"]

    total_reached = np.zeros(max_hops, dtype=np.int64)
    total_strict = np.zeros(max_hops, dtype=np.int64)
    total_ancdesc = np.zeros(max_hops, dtype=np.int64)

    for i, s in enumerate(seed_ints):
        reached, strict, ancdesc = _bfs_coherence(
            s, csr_offsets, csr_neighbors, cut_idx_array,
            n_unitigs, max_hops, concordance_table, parsed_cuts,
            simple_nidx, top_k_set, top_k_to_local,
            entry, exit_, tree_name_to_nidx)
        total_reached += reached
        total_strict += strict
        total_ancdesc += ancdesc

        if (i + 1) % 1000 == 0:
            logger.info(
                "Worker {}: BFS {}/{} seeds ({:.0f}%)",
                worker_id, i + 1, len(seed_ints),
                (i + 1) / len(seed_ints) * 100)

    return total_reached, total_strict, total_ancdesc


# ---------------------------------------------------------------------------
# Null expectations
# ---------------------------------------------------------------------------

def _simpson_index(colors: Dict[str, str]) -> float:
    """Probability two randomly chosen unitigs have the same cut-string.

    This is Σ fᵢ² (Simpson's index / Herfindahl index).
    """
    total = len(colors)
    if total == 0:
        return 0.0
    counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        counts[cs] += 1
    return sum((c / total) ** 2 for c in counts.values())


def _concordance_null(
    colors: Dict[str, str],
    unique_cuts: List[str],
    concordance_table: np.ndarray | None,
    parsed_cuts: List[List[FrozenSet[str]]],
    top_k_set: set | None,
    entry: np.ndarray,
    exit_: np.ndarray,
    tree_name_to_nidx: Dict[str, int],
    simple_nidx: np.ndarray,
    rng: np.random.Generator | None = None,
) -> float:
    """Null expectation for anc/desc coherence: Σ_{i,j coherent} f_i * f_j."""
    total = len(colors)
    if total == 0:
        return 0.0

    counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        counts[cs] += 1

    freqs = np.array([counts[cs] / total for cs in unique_cuts])

    # Full table available: exact computation
    if concordance_table is not None and top_k_set is None:
        return float(sum(
            freqs[i] * freqs[concordance_table[i]].sum()
            for i in range(len(freqs))
        ))

    # Large M or top-K table: sample-based estimation
    if rng is None:
        rng = np.random.default_rng(42)
    n_samples = 1_000_000
    idx_a = rng.choice(len(unique_cuts), size=n_samples, p=freqs)
    idx_b = rng.choice(len(unique_cuts), size=n_samples, p=freqs)

    n_coherent = 0
    for k in range(n_samples):
        i, j = int(idx_a[k]), int(idx_b[k])
        if i == j:
            n_coherent += 1
        elif simple_nidx[i] >= 0 and simple_nidx[j] >= 0:
            if _is_anc_or_desc(simple_nidx[i], simple_nidx[j], entry, exit_):
                n_coherent += 1
        elif _concordance_check(parsed_cuts[i], parsed_cuts[j],
                                entry, exit_, tree_name_to_nidx):
            n_coherent += 1

    estimate = n_coherent / n_samples
    se = (estimate * (1 - estimate) / n_samples) ** 0.5
    logger.info(
        "Anc/desc null estimated from {:,} samples: {:.6f} "
        "(SE \u2248 {:.6f})",
        n_samples, estimate, se)
    return estimate


# ---------------------------------------------------------------------------
# Plotting
# ---------------------------------------------------------------------------

def _plot_decay(
    hops: np.ndarray,
    coherence_strict: np.ndarray,
    coherence_ancdesc: np.ndarray,
    null_strict: float,
    null_ancdesc: float,
    output_path: Path,
) -> None:
    """Save a coherence-decay plot (SVG)."""
    import matplotlib
    matplotlib.use("Agg")
    matplotlib.rcParams["svg.fonttype"] = "none"
    import matplotlib.pyplot as plt
    import seaborn as sns

    sns.set_theme(style="white", context="notebook")
    fig, ax = plt.subplots(figsize=(7, 4.5))

    ax.plot(hops, coherence_ancdesc, marker="o", linewidth=1.5,
            markersize=4, label="Anc/desc coherence", color="tab:blue")
    ax.plot(hops, coherence_strict, marker="s", linewidth=1.5,
            markersize=3, linestyle="--", label="Strict coherence",
            color="tab:orange")
    ax.axhline(null_ancdesc, color="tab:blue", linestyle=":", linewidth=1,
               alpha=0.7, label=f"Null anc/desc = {null_ancdesc:.4f}")
    ax.axhline(null_strict, color="tab:orange", linestyle=":", linewidth=1,
               alpha=0.7, label=f"Null strict = {null_strict:.4f}")

    ax.set_xlabel("Hop distance")
    ax.set_ylabel("Coherence fraction")
    ax.set_title("Evolutionary persistence")
    ax.set_ylim(bottom=0)
    ax.legend()
    sns.despine(ax=ax, top=True, right=True)
    fig.tight_layout()
    fig.savefig(output_path, format="svg")
    plt.close(fig)
    logger.info("Plot saved to {}", output_path)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv: Sequence[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description="Evolutionary persistence — coherence decay along graph walks.")
    parser.add_argument(
        "--db", type=Path, required=True,
        help="SQLite database with unitigs and adjacency tables.")
    parser.add_argument(
        "--tree", type=Path, required=True,
        help="Postprocessed Newick tree with named internal nodes.")
    parser.add_argument(
        "--max-hops", type=int, default=20,
        help="Maximum BFS walk distance (default: 20).")
    parser.add_argument(
        "--samples", type=int, default=10_000,
        help="Number of seed unitigs to sample (default: 10000).")
    parser.add_argument(
        "--seed", type=int, default=42,
        help="Random seed for reproducibility (default: 42).")
    parser.add_argument(
        "--output", type=Path, required=True,
        help="Output TSV path.")
    parser.add_argument(
        "--plot", type=Path, default=None,
        help="Optional path for an SVG decay-curve plot.")
    parser.add_argument(
        "--jobs", type=int, default=1,
        help="Number of parallel workers (default: 1).")
    parser.add_argument(
        "-v", "--verbose", action="count", default=0,
        help="Increase verbosity (-v for INFO, -vv for DEBUG).")

    args = parser.parse_args(argv)
    _configure_logger(args.verbose)

    # -- Load tree and build Euler tour --------------------------------------
    logger.info("Loading tree from {}", args.tree)
    with args.tree.open() as fh:
        tree = Tree(fh.read(), parser=1)
    if not tree.name:
        tree.name = "Root"

    entry_times, exit_times, tree_name_to_nidx = _build_euler_tour(tree)
    logger.info(
        "Euler tour built for {:,} named nodes", len(tree_name_to_nidx))

    # -- Load graph ----------------------------------------------------------
    adj, colors = _load_graph_and_colors(args.db)

    # -- Build concordance lookup table --------------------------------------
    (unique_cuts, cut_to_idx, concordance_table,
     top_k_set, top_k_list, top_k_to_local, parsed_cuts, simple_nidx) = \
        _build_concordance_table(
            colors, entry_times, exit_times, tree_name_to_nidx)

    # -- Build integer-indexed CSR graph -------------------------------------
    unitig_list, uid_to_int, csr_offsets, csr_neighbors = \
        _build_csr_graph(adj, colors)
    N_unitigs = len(unitig_list)

    # Cut-string index for each unitig (int array indexed by unitig integer)
    cut_idx_array = np.array(
        [cut_to_idx[colors[uid]] for uid in unitig_list], dtype=np.int32)

    # -- Select seeds --------------------------------------------------------
    rng = np.random.default_rng(args.seed)
    n_seeds = min(args.samples, N_unitigs)
    if n_seeds == N_unitigs:
        seed_ints = list(range(N_unitigs))
        logger.info("Using all {:,} unitigs as seeds", n_seeds)
    else:
        seed_ints = list(
            rng.choice(N_unitigs, size=n_seeds, replace=False))
        logger.info("Sampled {:,} seed unitigs", n_seeds)

    # -- BFS from each seed --------------------------------------------------
    _SHARED["csr_offsets"] = csr_offsets
    _SHARED["csr_neighbors"] = csr_neighbors
    _SHARED["cut_idx_array"] = cut_idx_array
    _SHARED["n_unitigs"] = N_unitigs
    _SHARED["max_hops"] = args.max_hops
    _SHARED["concordance_table"] = concordance_table
    _SHARED["parsed_cuts"] = parsed_cuts
    _SHARED["simple_nidx"] = simple_nidx
    _SHARED["top_k_set"] = top_k_set
    _SHARED["top_k_to_local"] = top_k_to_local
    _SHARED["entry"] = entry_times
    _SHARED["exit_"] = exit_times
    _SHARED["tree_name_to_nidx"] = tree_name_to_nidx

    t0 = time.time()
    n_jobs = max(1, args.jobs)

    if n_jobs == 1:
        total_reached, total_strict, total_ancdesc = _worker_bfs(
            (seed_ints, 0))
    else:
        chunks = np.array_split(seed_ints, n_jobs)
        worker_args = [
            (list(chunk), i)
            for i, chunk in enumerate(chunks) if len(chunk) > 0
        ]

        total_reached = np.zeros(args.max_hops, dtype=np.int64)
        total_strict = np.zeros(args.max_hops, dtype=np.int64)
        total_ancdesc = np.zeros(args.max_hops, dtype=np.int64)

        ctx = mp.get_context("fork")
        with ctx.Pool(n_jobs) as pool:
            for reached, strict, ancdesc in pool.imap_unordered(
                _worker_bfs, worker_args
            ):
                total_reached += reached
                total_strict += strict
                total_ancdesc += ancdesc

    logger.info(
        "BFS complete: {:,} seeds in {:.1f}s", n_seeds, time.time() - t0)

    # -- Compute coherence and null ------------------------------------------
    with np.errstate(divide="ignore", invalid="ignore"):
        coherence_strict = np.where(
            total_reached > 0,
            total_strict / total_reached,
            np.nan)
        coherence_ancdesc = np.where(
            total_reached > 0,
            total_ancdesc / total_reached,
            np.nan)

    null_strict = _simpson_index(colors)
    null_ancdesc = _concordance_null(
        colors, unique_cuts, concordance_table, parsed_cuts, top_k_set,
        entry_times, exit_times, tree_name_to_nidx, simple_nidx, rng)

    logger.info("Null strict (Simpson index): {:.6f}", null_strict)
    logger.info("Null anc/desc: {:.6f}", null_ancdesc)

    # -- Write output --------------------------------------------------------
    args.output.parent.mkdir(parents=True, exist_ok=True)
    hops = np.arange(1, args.max_hops + 1)

    with args.output.open("w") as out:
        out.write(
            "hop_distance\tn_pairs\tn_strict_coherent\t"
            "n_ancdesc_coherent\tstrict_coherence\t"
            "ancdesc_coherence\tnull_strict\tnull_ancdesc\n")
        for h in range(args.max_hops):
            s_str = (f"{coherence_strict[h]:.6f}"
                     if not np.isnan(coherence_strict[h]) else "NA")
            c_str = (f"{coherence_ancdesc[h]:.6f}"
                     if not np.isnan(coherence_ancdesc[h]) else "NA")
            out.write(
                f"{hops[h]}\t{total_reached[h]}\t{total_strict[h]}\t"
                f"{total_ancdesc[h]}\t{s_str}\t"
                f"{c_str}\t{null_strict:.6f}\t{null_ancdesc:.6f}\n")

    logger.info("Output written to {}", args.output)

    # -- Plot ----------------------------------------------------------------
    if args.plot is not None:
        valid = ~np.isnan(coherence_strict) & ~np.isnan(coherence_ancdesc)
        if np.any(valid):
            args.plot.parent.mkdir(parents=True, exist_ok=True)
            _plot_decay(
                hops[valid], coherence_strict[valid], coherence_ancdesc[valid],
                null_strict, null_ancdesc, args.plot)
        else:
            logger.warning("No valid coherence data to plot")

    # -- Summary to stderr ---------------------------------------------------
    print("\n--- Evolutionary Persistence ---", file=sys.stderr)
    print(f"Seeds:                {n_seeds:,}", file=sys.stderr)
    print(f"Max hops:             {args.max_hops}", file=sys.stderr)
    print(f"Unique cut-strings:   {len(unique_cuts):,}", file=sys.stderr)
    print(f"Null strict:          {null_strict:.6f}", file=sys.stderr)
    print(f"Null anc/desc:        {null_ancdesc:.6f}", file=sys.stderr)
    if not np.isnan(coherence_strict[0]):
        print(
            f"Strict (h=1):         {coherence_strict[0]:.6f}",
            file=sys.stderr)
        print(
            f"Anc/desc (h=1):       {coherence_ancdesc[0]:.6f}",
            file=sys.stderr)
    # Find hop where each curve first drops below its null
    cross_s = np.where(
        (coherence_strict <= null_strict) & ~np.isnan(coherence_strict))[0]
    cross_c = np.where(
        (coherence_ancdesc <= null_ancdesc) & ~np.isnan(coherence_ancdesc))[0]
    print(
        f"Strict crosses null:  "
        f"{'hop ' + str(hops[cross_s[0]]) if len(cross_s) > 0 else 'never (within max-hops)'}",
        file=sys.stderr)
    print(
        f"Ancdesc crosses null: "
        f"{'hop ' + str(hops[cross_c[0]]) if len(cross_c) > 0 else 'never (within max-hops)'}",
        file=sys.stderr)
    print("------------------------------------", file=sys.stderr)


if __name__ == "__main__":
    main()
