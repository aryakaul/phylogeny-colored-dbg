#!/usr/bin/env python3
"""Boundary severity — phylogenetic discordance at graph edges.

Characterizes the phylogenetic distance between flanking evolutionary
histories at the boundaries of co-inherited blocks.  For every edge,
determines concordance (via ancestor-descendant matching) or discordance.
For discordant edges, computes tree distance and a sampling-based p-value.

The null model asks: "if phylogenetic assignments had no spatial
structure, what distribution of tree distances would we see at
discordant edges?"  It draws random pairs weighted by edge-endpoint
frequency, evaluates concordance/distance (mostly cache hits from the
observed-edge computation), and compares the resulting distribution to
the observed one via KS statistic and per-edge p-values.

Output
------
TSV with one row per edge (both concordant and discordant):

    unitig_a  unitig_b  cutstring_a  cutstring_b  tree_distance
    normalized_distance  concordant  pvalue

Concordant edges: tree_distance=0, normalized_distance=0, pvalue=NA.
Discordant edges with unresolvable distances are omitted.
"""

from __future__ import annotations

import argparse
import multiprocessing as mp
import sqlite3
import sys
import time
from collections import defaultdict, deque
from pathlib import Path
from typing import Dict, FrozenSet, List, Sequence, Tuple

import numpy as np

try:
    from ete4 import Tree
except ImportError:
    from ete3 import Tree

try:
    from loguru import logger
except ImportError:
    import logging
    logger = logging.getLogger(__name__)


# ---------------------------------------------------------------------------
# Logger
# ---------------------------------------------------------------------------

def _configure_logger(verbosity: int) -> None:
    """0 → WARNING, 1 → INFO, 2+ → DEBUG."""
    try:
        from loguru import logger as _lg
        _lg.remove()
        level = "WARNING" if verbosity == 0 else (
            "INFO" if verbosity == 1 else "DEBUG")
        _lg.add(sys.stderr, level=level)
    except ImportError:
        import logging
        level = (logging.WARNING if verbosity == 0
                 else logging.INFO if verbosity == 1
                 else logging.DEBUG)
        logging.basicConfig(level=level, stream=sys.stderr)


# ---------------------------------------------------------------------------
# Tree: Euler tour for O(1) ancestor-descendant queries
# ---------------------------------------------------------------------------

def _build_euler_tour(
    tree: Tree,
    name_to_nidx: Dict[str, int] | None = None,
) -> Tuple[np.ndarray, np.ndarray, Dict[str, int]]:
    """Euler-tour entry/exit times for O(1) ancestor-descendant queries.

    Returns:
        entry  -- int32 array indexed by node index, DFS entry time
        exit_  -- int32 array indexed by node index, DFS exit time
        name_to_nidx -- mapping from node name to index (built or reused)
    """
    if name_to_nidx is None:
        named_nodes = sorted({n.name for n in tree.traverse() if n.name})
        name_to_nidx = {n: i for i, n in enumerate(named_nodes)}
    N = len(name_to_nidx)

    entry = np.zeros(N, dtype=np.int32)
    exit_ = np.zeros(N, dtype=np.int32)

    clock = 0
    stack: List[Tuple[Tree, bool]] = [(tree, False)]
    while stack:
        node, leaving = stack.pop()
        if leaving:
            if node.name and node.name in name_to_nidx:
                exit_[name_to_nidx[node.name]] = clock
            clock += 1
        else:
            if node.name and node.name in name_to_nidx:
                entry[name_to_nidx[node.name]] = clock
            clock += 1
            stack.append((node, True))
            for child in reversed(node.children):
                stack.append((child, False))

    return entry, exit_, name_to_nidx


# ---------------------------------------------------------------------------
# Tree: pairwise topological distances via BFS
# ---------------------------------------------------------------------------

def _build_node_distances(
    tree: Tree,
) -> Tuple[List[str], np.ndarray, int]:
    """Pairwise topological distances between all named tree nodes.

    Uses BFS from every named node on the tree adjacency list.
    Produces an N×N int16 matrix for O(1) distance lookups.

    Returns:
        node_names -- sorted list of named node names
        dist_np    -- N×N int16 numpy array of pairwise distances
        diam       -- tree diameter
    """
    node_key: Dict[int, str] = {}
    named_keys: set[str] = set()
    for node in tree.traverse():
        key = node.name if node.name else f"__anon_{id(node)}"
        node_key[id(node)] = key
        if node.name:
            named_keys.add(key)

    adj: Dict[str, List[str]] = defaultdict(list)
    for node in tree.traverse():
        pk = node_key[id(node)]
        for child in node.children:
            ck = node_key[id(child)]
            adj[pk].append(ck)
            adj[ck].append(pk)

    node_names = sorted(named_keys)
    name_to_idx = {n: i for i, n in enumerate(node_names)}
    N = len(node_names)
    dist_np = np.zeros((N, N), dtype=np.int16)

    for start in node_names:
        si = name_to_idx[start]
        visited = {start: 0}
        queue: deque[str] = deque([start])
        while queue:
            cur = queue.popleft()
            for nb in adj[cur]:
                if nb not in visited:
                    visited[nb] = visited[cur] + 1
                    queue.append(nb)
        for k, v in visited.items():
            if k in name_to_idx:
                dist_np[si, name_to_idx[k]] = v

    diam = int(dist_np.max())
    logger.info(
        "Node distances: {} named nodes, diameter = {}", N, diam)
    return node_names, dist_np, diam


# ---------------------------------------------------------------------------
# Cut-string parsing, classification, and containment
# ---------------------------------------------------------------------------

def _parse_cutstring(raw: str) -> List[FrozenSet[str]]:
    """Parse a raw cut-string into a list of alternative solutions."""
    if not raw or raw.strip().lower() == "none":
        return []
    alts: List[FrozenSet[str]] = []
    for option in raw.split(" OR "):
        nodes = frozenset(n.strip() for n in option.split(",") if n.strip())
        if nodes:
            alts.append(nodes)
    return alts


def _is_anc_or_desc(
    a: int, b: int,
    entry: np.ndarray, exit_: np.ndarray,
) -> bool:
    """O(1) ancestor-or-descendant check via Euler-tour times."""
    return ((entry[a] <= entry[b] and exit_[b] <= exit_[a]) or
            (entry[b] <= entry[a] and exit_[a] <= exit_[b]))


def _concordance_check(
    sols_a: List[FrozenSet[str]],
    sols_b: List[FrozenSet[str]],
    entry: np.ndarray,
    exit_: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> bool:
    """True if any pair of alternative solutions has a concordant matching.

    A concordant matching is an injective mapping from the smaller set into
    the larger where every mapped pair is in an ancestor-descendant-or-equal
    relationship on the tree.
    """
    for sa in sols_a:
        for sb in sols_b:
            if _injective_ancdesc_match(sa, sb, entry, exit_, name_to_nidx):
                return True
    return False


def _injective_ancdesc_match(
    set_a: FrozenSet[str],
    set_b: FrozenSet[str],
    entry: np.ndarray,
    exit_: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> bool:
    """Check if an injective anc/desc matching exists from smaller into larger."""
    # Resolve to indices, skip unknown nodes
    idx_a = [name_to_nidx[n] for n in set_a if n in name_to_nidx]
    idx_b = [name_to_nidx[n] for n in set_b if n in name_to_nidx]
    if not idx_a or not idx_b:
        return False

    # Ensure |small| <= |large|
    if len(idx_a) > len(idx_b):
        idx_a, idx_b = idx_b, idx_a

    # Single vs single: O(1)
    if len(idx_a) == 1:
        a = idx_a[0]
        return any(_is_anc_or_desc(a, b, entry, exit_) for b in idx_b)

    # Multi vs multi: brute-force injective matchings (sets are tiny, 2-4 nodes)
    from itertools import permutations
    for perm in permutations(idx_b, len(idx_a)):
        if all(_is_anc_or_desc(idx_a[i], perm[i], entry, exit_)
               for i in range(len(idx_a))):
            return True
    return False


def _classify_cutstrings(
    unique_cs: List[str],
    name_to_nidx: Dict[str, int],
) -> Tuple[np.ndarray, np.ndarray, List[List[FrozenSet[str]]]]:
    """Classify cut-strings as simple (single tree node) or complex.

    Returns:
        is_simple       -- bool array [U]
        simple_node_idx -- int32 array [U], tree-node index or -1
        parsed_cs       -- parsed form of each unique cut-string
    """
    U = len(unique_cs)
    is_simple = np.zeros(U, dtype=np.bool_)
    simple_node_idx = np.full(U, -1, dtype=np.int32)
    parsed_cs = []

    for i, cs in enumerate(unique_cs):
        p = _parse_cutstring(cs)
        parsed_cs.append(p)
        if len(p) == 1 and len(p[0]) == 1:
            node_name = next(iter(p[0]))
            nidx = name_to_nidx.get(node_name)
            if nidx is not None:
                is_simple[i] = True
                simple_node_idx[i] = nidx

    n_simple = int(is_simple.sum())
    logger.info(
        "Cut-string classification: {:,} simple ({:.1f}%), {:,} complex",
        n_simple, 100.0 * n_simple / max(U, 1), U - n_simple)
    return is_simple, simple_node_idx, parsed_cs


# ---------------------------------------------------------------------------
# Single-pair distance computation
# ---------------------------------------------------------------------------

def _solution_distance(
    sol_a: FrozenSet[str],
    sol_b: FrozenSet[str],
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> float:
    """Distance between two single solutions.  -1.0 if unresolvable."""
    if sol_a == sol_b:
        return 0.0
    idx_a = [name_to_nidx.get(n) for n in sol_a]
    idx_b = [name_to_nidx.get(n) for n in sol_b]
    if any(i is None for i in idx_a) or any(i is None for i in idx_b):
        return -1.0
    if len(idx_a) == 1 and len(idx_b) == 1:
        return float(node_dist_np[idx_a[0], idx_b[0]])
    ia = np.array(idx_a, dtype=np.int32)
    ib = np.array(idx_b, dtype=np.int32)
    sub = node_dist_np[np.ix_(ia, ib)].astype(np.float64)
    d_ab = float(sub.min(axis=1).mean())
    d_ba = float(sub.min(axis=0).mean())
    return (d_ab + d_ba) / 2.0


def _assignment_distance(
    alts_a: List[FrozenSet[str]],
    alts_b: List[FrozenSet[str]],
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> float:
    """Distance between two full assignments (handling OR-ambiguity)."""
    set_a = set(alts_a)
    if any(sb in set_a for sb in alts_b):
        return 0.0
    best = float("inf")
    for sa in alts_a:
        for sb in alts_b:
            d = _solution_distance(sa, sb, node_dist_np, name_to_nidx)
            if 0 <= d < best:
                best = d
    return best if best < float("inf") else -1.0


def _pair_distance(
    cs_a: int,
    cs_b: int,
    is_simple: np.ndarray,
    simple_node_idx: np.ndarray,
    node_dist_np: np.ndarray,
    parsed_cs: List[List[FrozenSet[str]]],
    name_to_nidx: Dict[str, int],
) -> float:
    """Compute tree distance between two cut-string indices."""
    if is_simple[cs_a] and is_simple[cs_b]:
        return float(node_dist_np[simple_node_idx[cs_a], simple_node_idx[cs_b]])
    p_a, p_b = parsed_cs[cs_a], parsed_cs[cs_b]
    if p_a and p_b:
        return _assignment_distance(p_a, p_b, node_dist_np, name_to_nidx)
    return -1.0


# ---------------------------------------------------------------------------
# Pair cache: score unique (cs_a, cs_b) pairs
# ---------------------------------------------------------------------------

def _build_pair_cache(
    all_cs_a: np.ndarray,
    all_cs_b: np.ndarray,
    parsed_cs: List[List[FrozenSet[str]]],
    is_simple: np.ndarray,
    simple_node_idx: np.ndarray,
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
    entry: np.ndarray,
    exit_: np.ndarray,
) -> Tuple[Dict[Tuple[int, int], Tuple[bool, float]], int, int, int]:
    """Score every unique (cs_a, cs_b) pair that appears at an edge.

    Returns:
        cache        -- {(min_idx, max_idx): (concordant, distance)}
        n_identical  -- count of edges with identical cut-strings
        n_concordant_ad -- count of edges concordant by anc/desc (not identical)
        n_discordant -- count of discordant edges
    """
    E = len(all_cs_a)
    cache: Dict[Tuple[int, int], Tuple[bool, float]] = {}

    # Gather unique pairs
    same = all_cs_a == all_cs_b
    n_identical = int(same.sum())

    diff_indices = np.where(~same)[0]
    if len(diff_indices) > 0:
        pairs = np.column_stack([all_cs_a[diff_indices], all_cs_b[diff_indices]])
        unique_pairs = np.unique(pairs, axis=0)
    else:
        unique_pairs = np.empty((0, 2), dtype=np.int32)

    logger.info(
        "Scoring {:,} unique non-identical pairs (from {:,} edges)",
        len(unique_pairs), len(diff_indices))

    n_concordant_ad_pairs = 0
    n_discordant_pairs = 0

    for a, b in unique_pairs:
        a, b = int(a), int(b)
        key = (min(a, b), max(a, b))
        if key in cache:
            continue

        if _concordance_check(parsed_cs[a], parsed_cs[b], entry, exit_, name_to_nidx):
            cache[key] = (True, 0.0)
            n_concordant_ad_pairs += 1
        else:
            dist = _pair_distance(
                a, b, is_simple, simple_node_idx,
                node_dist_np, parsed_cs, name_to_nidx)
            cache[key] = (False, dist)
            n_discordant_pairs += 1

    # Map unique-pair results back to edge counts
    n_concordant_ad_edges = 0
    n_discordant_edges = 0
    for ei in diff_indices:
        a, b = int(all_cs_a[ei]), int(all_cs_b[ei])
        key = (min(a, b), max(a, b))
        conc, _ = cache[key]
        if conc:
            n_concordant_ad_edges += 1
        else:
            n_discordant_edges += 1

    logger.info(
        "Edge breakdown: {:,} identical, {:,} anc/desc-concordant, "
        "{:,} discordant ({:,} unique discordant pairs)",
        n_identical, n_concordant_ad_edges, n_discordant_edges,
        n_discordant_pairs)

    return cache, n_identical, n_concordant_ad_edges, n_discordant_edges


def _lookup_pair(
    a: int, b: int,
    cache: Dict[Tuple[int, int], Tuple[bool, float]],
    parsed_cs: List[List[FrozenSet[str]]],
    is_simple: np.ndarray,
    simple_node_idx: np.ndarray,
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
    entry: np.ndarray,
    exit_: np.ndarray,
) -> Tuple[bool, float]:
    """Look up or compute a pair result.  Cache miss → on-the-fly."""
    if a == b:
        return (True, 0.0)
    key = (min(a, b), max(a, b))
    result = cache.get(key)
    if result is not None:
        return result
    # Cache miss: compute on the fly
    if _concordance_check(parsed_cs[a], parsed_cs[b], entry, exit_, name_to_nidx):
        return (True, 0.0)
    dist = _pair_distance(
        a, b, is_simple, simple_node_idx,
        node_dist_np, parsed_cs, name_to_nidx)
    return (False, dist)


# ---------------------------------------------------------------------------
# Shared state for fork-based multiprocessing
# ---------------------------------------------------------------------------

_SHARED: Dict = {}


# ---------------------------------------------------------------------------
# Null model: weighted pair sampling
# ---------------------------------------------------------------------------

def _null_worker(args_tuple):
    """Draw random pairs, evaluate concordance/distance."""
    n_samples, seed = args_tuple

    pair_cache = _SHARED["pair_cache"]
    endpoint_probs = _SHARED["endpoint_probs"]
    n_cs = _SHARED["n_cs"]
    parsed_cs = _SHARED["parsed_cs"]
    is_simple = _SHARED["is_simple"]
    simple_node_idx = _SHARED["simple_node_idx"]
    node_dist_np = _SHARED["node_dist_np"]
    name_to_nidx = _SHARED["name_to_nidx"]
    entry = _SHARED["entry"]
    exit_ = _SHARED["exit_"]

    rng = np.random.default_rng(seed)
    idx_a = rng.choice(n_cs, size=n_samples, p=endpoint_probs)
    idx_b = rng.choice(n_cs, size=n_samples, p=endpoint_probs)

    null_dists: List[float] = []
    n_concordant = 0

    for k in range(n_samples):
        a, b = int(idx_a[k]), int(idx_b[k])
        conc, dist = _lookup_pair(
            a, b, pair_cache, parsed_cs,
            is_simple, simple_node_idx, node_dist_np, name_to_nidx,
            entry, exit_)
        if conc:
            n_concordant += 1
        elif dist >= 0:
            null_dists.append(dist)

    return null_dists, n_concordant, n_samples


def _run_null_model(
    n_samples: int,
    n_jobs: int,
    rng: np.random.Generator,
) -> Tuple[np.ndarray, int, int]:
    """Weighted pair sampling null model.

    Returns:
        null_distances -- sorted array of distances from discordant null pairs
        n_concordant   -- number of concordant null pairs
        n_total        -- total null pairs drawn
    """
    chunk_size = (n_samples + n_jobs - 1) // n_jobs
    worker_args = []
    for i in range(n_jobs):
        n = min(chunk_size, n_samples - i * chunk_size)
        if n <= 0:
            break
        worker_seed = int(rng.integers(0, 2**62))
        worker_args.append((n, worker_seed))

    all_dists: List[float] = []
    total_concordant = 0
    total_samples = 0

    if n_jobs == 1:
        dists, conc, total = _null_worker(worker_args[0])
        all_dists = dists
        total_concordant = conc
        total_samples = total
    else:
        ctx = mp.get_context("fork")
        with ctx.Pool(n_jobs) as pool:
            for dists, conc, total in pool.imap_unordered(
                _null_worker, worker_args
            ):
                all_dists.extend(dists)
                total_concordant += conc
                total_samples += total

    null_sorted = np.sort(np.array(all_dists, dtype=np.float32))
    logger.info(
        "Null model: {:,} total samples, {:,} concordant ({:.1f}%), "
        "{:,} discordant distances collected",
        total_samples, total_concordant,
        100.0 * total_concordant / max(total_samples, 1),
        len(null_sorted))

    return null_sorted, total_concordant, total_samples


# ---------------------------------------------------------------------------
# KS statistic
# ---------------------------------------------------------------------------

def _ks_2sample(obs: np.ndarray, null: np.ndarray) -> float:
    """Two-sample Kolmogorov-Smirnov statistic (no scipy needed)."""
    n1, n2 = len(obs), len(null)
    if n1 == 0 or n2 == 0:
        return 0.0
    combined = np.concatenate([obs, null])
    combined.sort()
    cdf1 = np.searchsorted(obs, combined, side="right").astype(np.float64) / n1
    cdf2 = np.searchsorted(null, combined, side="right").astype(np.float64) / n2
    return float(np.max(np.abs(cdf1 - cdf2)))


# ---------------------------------------------------------------------------
# Plot
# ---------------------------------------------------------------------------

def _plot_boundary_severity(
    observed_dists: np.ndarray,
    null_sorted: np.ndarray,
    n_concordant: int,
    n_identical: int,
    n_concordant_ad: int,
    ks_stat: float,
    output_path: Path,
) -> None:
    """Two-panel figure: distance histogram + empirical CDF comparison."""
    import matplotlib
    matplotlib.use("Agg")
    matplotlib.rcParams["svg.fonttype"] = "none"
    import matplotlib.pyplot as plt
    import seaborn as sns

    sns.set_theme(style="white", context="notebook")
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4.5))

    obs_sorted = np.sort(observed_dists)
    mean_obs = float(obs_sorted.mean()) if len(obs_sorted) > 0 else 0
    mean_null = float(null_sorted.mean()) if len(null_sorted) > 0 else 0

    # -- Left panel: distance histograms --
    if len(obs_sorted) > 0:
        bins = np.linspace(
            0, max(obs_sorted.max(), null_sorted.max() if len(null_sorted) > 0 else 0),
            51)
        ax1.hist(obs_sorted, bins=bins, density=True, alpha=0.8,
                 color="tab:blue", label="Observed", edgecolor="none")
        if len(null_sorted) > 0:
            ax1.hist(null_sorted, bins=bins, density=True, alpha=0.35,
                     color="grey", label="Null", edgecolor="none")

        ax1.axvline(mean_obs, color="tab:blue", linestyle="--",
                     linewidth=1, alpha=0.8, label=f"Mean obs = {mean_obs:.2f}")
        if len(null_sorted) > 0:
            ax1.axvline(mean_null, color="grey", linestyle="--",
                         linewidth=1, alpha=0.8,
                         label=f"Mean null = {mean_null:.2f}")

    pct_identical = 100.0 * n_identical / max(n_concordant, 1)
    pct_ancdesc = 100.0 * n_concordant_ad / max(n_concordant, 1)
    ax1.set_xlabel("Tree distance")
    ax1.set_ylabel("Density")
    ax1.set_title(
        f"Discordant edge distances\n"
        f"({n_concordant:,} concordant excluded: "
        f"{pct_identical:.0f}% identical, {pct_ancdesc:.0f}% anc/desc)")
    ax1.annotate(f"KS = {ks_stat:.4f}", xy=(0.97, 0.97),
                 xycoords="axes fraction", ha="right", va="top",
                 fontsize=9, bbox=dict(boxstyle="round,pad=0.3",
                                        fc="white", ec="grey", alpha=0.8))
    ax1.legend(fontsize=8)
    sns.despine(ax=ax1, top=True, right=True)

    # -- Right panel: empirical CDF comparison --
    if len(obs_sorted) > 0:
        obs_cdf_y = np.arange(1, len(obs_sorted) + 1) / len(obs_sorted)
        ax2.step(obs_sorted, obs_cdf_y, where="post", color="tab:blue",
                 linewidth=1.5, label="Observed")
    if len(null_sorted) > 0:
        null_cdf_y = np.arange(1, len(null_sorted) + 1) / len(null_sorted)
        ax2.step(null_sorted, null_cdf_y, where="post", color="grey",
                 linewidth=1.5, alpha=0.7, label="Null")

    # Annotate max KS separation
    if len(obs_sorted) > 0 and len(null_sorted) > 0:
        combined = np.unique(np.concatenate([obs_sorted, null_sorted]))
        cdf1 = np.searchsorted(obs_sorted, combined, side="right").astype(float) / len(obs_sorted)
        cdf2 = np.searchsorted(null_sorted, combined, side="right").astype(float) / len(null_sorted)
        diffs = np.abs(cdf1 - cdf2)
        ks_idx = np.argmax(diffs)
        ks_x = combined[ks_idx]
        ks_y_lo = min(cdf1[ks_idx], cdf2[ks_idx])
        ks_y_hi = max(cdf1[ks_idx], cdf2[ks_idx])
        ax2.annotate("", xy=(ks_x, ks_y_hi), xytext=(ks_x, ks_y_lo),
                     arrowprops=dict(arrowstyle="<->", color="tab:red",
                                      lw=1.5))
        ax2.annotate(f"KS = {ks_stat:.4f}",
                     xy=(ks_x, (ks_y_lo + ks_y_hi) / 2),
                     xytext=(10, 0), textcoords="offset points",
                     fontsize=9, color="tab:red", va="center")

    ax2.set_xlabel("Tree distance")
    ax2.set_ylabel("Cumulative fraction")
    ax2.set_title("Empirical CDF: observed vs null")
    ax2.legend(fontsize=8)
    sns.despine(ax=ax2, top=True, right=True)

    fig.tight_layout()
    output_path.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(output_path, format="svg")
    plt.close(fig)
    logger.info("Plot saved to {}", output_path)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv: Sequence[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description="Boundary severity — phylogenetic discordance at graph edges.")
    parser.add_argument(
        "--tree", type=Path, required=True,
        help="Postprocessed Newick tree with named internal nodes.")
    parser.add_argument(
        "--db", type=Path, required=True,
        help="SQLite database with unitigs (colors) and adjacency tables.")
    parser.add_argument(
        "--null-samples", type=int, default=5_000_000,
        help="Random pairs for null distribution (default: 5000000).")
    parser.add_argument(
        "--output", type=Path, required=True,
        help="Output TSV path.")
    parser.add_argument(
        "--plot", type=Path, default=None,
        help="Optional SVG plot path (two-panel: histogram + CDF).")
    parser.add_argument(
        "--seed", type=int, default=42,
        help="Random seed for reproducibility (default: 42).")
    parser.add_argument(
        "--jobs", type=int, default=1,
        help="Number of parallel workers (default: 1).")
    parser.add_argument(
        "-v", "--verbose", action="count", default=0,
        help="Increase verbosity (-v for INFO, -vv for DEBUG).")

    args = parser.parse_args(argv)
    _configure_logger(args.verbose)

    # -- Load tree and build node distances ----------------------------------
    logger.info("Loading tree from {}", args.tree)
    with args.tree.open() as fh:
        tree = Tree(fh.read(), parser=1)
    if not tree.name:
        tree.name = "Root"

    t0 = time.time()
    node_names, node_dist_np, diameter = _build_node_distances(tree)
    name_to_nidx = {n: i for i, n in enumerate(node_names)}
    logger.info("Node distances computed in {:.1f}s", time.time() - t0)

    # Euler tour for O(1) ancestor-descendant queries
    entry_np, exit_np, _ = _build_euler_tour(tree, name_to_nidx)
    logger.info("Euler tour built for {:,} named nodes", len(name_to_nidx))

    if diameter == 0:
        logger.error("Tree diameter is 0; cannot normalize distances.")
        sys.exit(1)

    # -- Load assignments and edges from SQLite ------------------------------
    logger.info("Loading data from {}", args.db)
    conn = sqlite3.connect(args.db)

    unitig_colors: Dict[str, str] = {}
    for uid, colors in conn.execute("SELECT unitig_id, colors FROM unitigs"):
        unitig_colors[uid] = colors if colors else "None"

    edges_seen: set = set()
    edges_dedup: List[Tuple[str, str]] = []
    for uid_a, _, uid_b, _ in conn.execute(
        "SELECT unitig_id, unitig_direction, neighbor_id, "
        "neighbor_direction FROM adjacency"
    ):
        key = (uid_a, uid_b) if uid_a <= uid_b else (uid_b, uid_a)
        if key not in edges_seen:
            edges_seen.add(key)
            edges_dedup.append((uid_a, uid_b))
    conn.close()
    del edges_seen

    logger.info(
        "Loaded {:,} unitigs, {:,} undirected edges",
        len(unitig_colors), len(edges_dedup))

    # -- Index: unitigs → integers, cut-strings → integers -------------------
    assigned_unitigs = {
        uid for uid, cs in unitig_colors.items()
        if cs.strip().lower() != "none" and cs.strip()
    }

    unique_cs = sorted({unitig_colors[uid] for uid in assigned_unitigs})
    cs_to_idx = {cs: i for i, cs in enumerate(unique_cs)}
    n_cs = len(unique_cs)
    logger.info("{:,} unique non-None cut-strings", n_cs)

    unitig_list = sorted(assigned_unitigs)
    unitig_to_flat = {uid: i for i, uid in enumerate(unitig_list)}
    assignment_indices = np.array(
        [cs_to_idx[unitig_colors[uid]] for uid in unitig_list],
        dtype=np.int32)

    # -- Classify cut-strings ------------------------------------------------
    t0 = time.time()
    is_simple, simple_node_idx, parsed_cs = \
        _classify_cutstrings(unique_cs, name_to_nidx)
    logger.info("Cut-strings classified in {:.1f}s", time.time() - t0)

    # -- Filter edges: both endpoints must be assigned -----------------------
    edge_a_flat: List[int] = []
    edge_b_flat: List[int] = []
    edge_meta: List[Tuple[str, str, str, str]] = []

    for uid_a, uid_b in edges_dedup:
        if uid_a not in unitig_to_flat or uid_b not in unitig_to_flat:
            continue
        cs_a = unitig_colors[uid_a]
        cs_b = unitig_colors[uid_b]
        edge_a_flat.append(unitig_to_flat[uid_a])
        edge_b_flat.append(unitig_to_flat[uid_b])
        edge_meta.append((uid_a, uid_b, cs_a, cs_b))

    all_edge_a_idx = np.array(edge_a_flat, dtype=np.int32)
    all_edge_b_idx = np.array(edge_b_flat, dtype=np.int32)
    E_all = len(edge_meta)
    logger.info("{:,} edges with both endpoints assigned", E_all)

    all_cs_a = assignment_indices[all_edge_a_idx]
    all_cs_b = assignment_indices[all_edge_b_idx]

    # -- Build pair cache: score all unique co-occurring pairs ---------------
    t0 = time.time()
    pair_cache, n_identical, n_concordant_ad, n_discordant = _build_pair_cache(
        all_cs_a, all_cs_b, parsed_cs,
        is_simple, simple_node_idx, node_dist_np, name_to_nidx,
        entry_np, exit_np)
    n_concordant = n_identical + n_concordant_ad
    logger.info("Pair cache built in {:.1f}s ({:,} entries)",
                time.time() - t0, len(pair_cache))

    # -- Score every edge using the cache ------------------------------------
    edge_concordant = np.zeros(E_all, dtype=np.bool_)
    edge_distance = np.full(E_all, -1.0, dtype=np.float32)

    for i in range(E_all):
        a, b = int(all_cs_a[i]), int(all_cs_b[i])
        if a == b:
            edge_concordant[i] = True
            edge_distance[i] = 0.0
        else:
            key = (min(a, b), max(a, b))
            conc, dist = pair_cache[key]
            edge_concordant[i] = conc
            edge_distance[i] = 0.0 if conc else dist

    discordant_mask = ~edge_concordant & (edge_distance >= 0)
    observed_discordant_dists = edge_distance[discordant_mask]
    n_valid_discordant = len(observed_discordant_dists)

    mean_obs = (float(observed_discordant_dists.mean())
                if n_valid_discordant > 0 else 0.0)
    median_obs = (float(np.median(observed_discordant_dists))
                  if n_valid_discordant > 0 else 0.0)

    logger.info(
        "Observed: {:,} concordant, {:,} discordant (valid), "
        "mean dist = {:.4f}, median = {:.4f}",
        n_concordant, n_valid_discordant, mean_obs, median_obs)

    # -- Null model: weighted pair sampling ----------------------------------
    # Compute edge-endpoint frequency distribution
    endpoint_counts = np.zeros(n_cs, dtype=np.int64)
    for i in range(E_all):
        endpoint_counts[all_cs_a[i]] += 1
        endpoint_counts[all_cs_b[i]] += 1

    # Only include indices that actually appear at edges
    active_mask = endpoint_counts > 0
    n_active = int(active_mask.sum())
    endpoint_probs = np.zeros(n_cs, dtype=np.float64)
    endpoint_probs[active_mask] = (
        endpoint_counts[active_mask].astype(np.float64)
        / endpoint_counts[active_mask].sum())

    logger.info(
        "Endpoint frequency distribution: {:,} active cut-string indices",
        n_active)

    rng = np.random.default_rng(args.seed)
    n_jobs = max(1, args.jobs)
    null_sorted = np.empty(0, dtype=np.float32)
    null_concordant = 0
    null_total = 0
    mean_null = 0.0
    sd_null = 0.0

    if args.null_samples > 0 and n_valid_discordant > 0:
        _SHARED["pair_cache"] = pair_cache
        _SHARED["endpoint_probs"] = endpoint_probs
        _SHARED["n_cs"] = n_cs
        _SHARED["parsed_cs"] = parsed_cs
        _SHARED["is_simple"] = is_simple
        _SHARED["simple_node_idx"] = simple_node_idx
        _SHARED["node_dist_np"] = node_dist_np
        _SHARED["name_to_nidx"] = name_to_nidx
        _SHARED["entry"] = entry_np
        _SHARED["exit_"] = exit_np

        t0 = time.time()
        logger.info(
            "Running null model: {:,} weighted pair samples across {} workers...",
            args.null_samples, n_jobs)
        null_sorted, null_concordant, null_total = _run_null_model(
            args.null_samples, n_jobs, rng)
        logger.info("Null model done in {:.1f}s", time.time() - t0)

        if len(null_sorted) > 0:
            mean_null = float(null_sorted.mean())
            sd_null = float(null_sorted.std())

    # -- Per-edge p-values via binary search on sorted null ------------------
    edge_pvalues = np.full(E_all, np.nan, dtype=np.float64)

    if len(null_sorted) > 0:
        N_null = len(null_sorted)
        for i in range(E_all):
            if not edge_concordant[i] and edge_distance[i] >= 0:
                d = float(edge_distance[i])
                idx = np.searchsorted(null_sorted, d, side="left")
                edge_pvalues[i] = (N_null - idx) / N_null

    # -- KS statistic --------------------------------------------------------
    obs_sorted = np.sort(observed_discordant_dists)
    ks_stat = _ks_2sample(obs_sorted, null_sorted)

    # Try scipy for p-value
    ks_pval = None
    try:
        from scipy.stats import ks_2samp
        if len(obs_sorted) > 0 and len(null_sorted) > 0:
            _, ks_pval = ks_2samp(obs_sorted, null_sorted)
    except ImportError:
        pass

    # -- Write output --------------------------------------------------------
    args.output.parent.mkdir(parents=True, exist_ok=True)

    columns = [
        "unitig_a", "unitig_b",
        "cutstring_a", "cutstring_b",
        "tree_distance", "normalized_distance",
        "concordant", "pvalue",
    ]

    n_written = 0
    with args.output.open("w") as out:
        out.write("\t".join(columns) + "\n")
        for i in range(E_all):
            uid_a, uid_b, cs_a, cs_b = edge_meta[i]
            d = float(edge_distance[i])

            if edge_concordant[i]:
                out.write(
                    f"{uid_a}\t{uid_b}\t{cs_a}\t{cs_b}\t"
                    f"0\t0\tTrue\tNA\n")
                n_written += 1
            elif d >= 0:
                norm_d = d / diameter
                pval = edge_pvalues[i]
                pval_str = f"{pval:.6g}" if np.isfinite(pval) else "NA"
                out.write(
                    f"{uid_a}\t{uid_b}\t{cs_a}\t{cs_b}\t"
                    f"{d:.4g}\t{norm_d:.6f}\tFalse\t{pval_str}\n")
                n_written += 1

    logger.info("Wrote {:,} scored edges to {}", n_written, args.output)

    # -- Summary to stderr ---------------------------------------------------
    median_null = float(np.median(null_sorted)) if len(null_sorted) > 0 else 0.0
    null_conc_rate = (null_concordant / null_total * 100) if null_total > 0 else 0
    obs_conc_rate = n_concordant / max(E_all, 1) * 100

    print("\n--- Boundary Severity Summary ---", file=sys.stderr)
    print(f"Total edges:                  {E_all:,}", file=sys.stderr)
    print(
        f"  Concordant:                 {n_concordant:,} ({obs_conc_rate:.1f}%)",
        file=sys.stderr)
    print(
        f"    Identical:                {n_identical:,} "
        f"({100.0 * n_identical / max(E_all, 1):.1f}%)", file=sys.stderr)
    print(
        f"    Anc/desc concordance:     {n_concordant_ad:,} "
        f"({100.0 * n_concordant_ad / max(E_all, 1):.1f}%)", file=sys.stderr)
    print(f"  Discordant:                 {n_discordant:,} "
          f"({100.0 * n_discordant / max(E_all, 1):.1f}%)", file=sys.stderr)

    print(f"Mean observed tree dist:      {mean_obs:.4f}", file=sys.stderr)
    print(f"Median observed tree dist:    {median_obs:.4f}", file=sys.stderr)

    if len(null_sorted) > 0:
        print(
            f"Mean null tree dist:          {mean_null:.4f} "
            f"(\u00b1 {sd_null:.4f})", file=sys.stderr)
        print(f"Median null tree dist:        {median_null:.4f}", file=sys.stderr)
        print(
            f"Null concordance rate:        {null_conc_rate:.1f}% "
            f"(obs: {obs_conc_rate:.1f}%)", file=sys.stderr)

        ks_pval_str = f"{ks_pval:.2e}" if ks_pval is not None else "N/A (scipy not installed)"
        print(f"KS statistic:                 {ks_stat:.4f}", file=sys.stderr)
        print(f"KS p-value:                   {ks_pval_str}", file=sys.stderr)

        n_sig = int(np.sum(edge_pvalues[np.isfinite(edge_pvalues)] < 0.05))
        n_tested = int(np.sum(np.isfinite(edge_pvalues)))
        frac_sig = n_sig / max(n_tested, 1)
        print(
            f"Fraction p < 0.05:            {frac_sig:.4f} "
            f"({n_sig:,}/{n_tested:,})", file=sys.stderr)

    print("---------------------------------", file=sys.stderr)

    # -- Plot (if --plot) ----------------------------------------------------
    if args.plot is not None and n_valid_discordant > 0:
        _plot_boundary_severity(
            observed_discordant_dists, null_sorted,
            n_concordant, n_identical, n_concordant_ad,
            ks_stat, args.plot)


if __name__ == "__main__":
    main()
