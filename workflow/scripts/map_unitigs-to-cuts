#!/usr/bin/env python3

import sys

redundant_colors_file = sys.argv[1]
minimal_cuts_file = sys.argv[2]
output = sys.argv[3]

with open(redundant_colors_file, 'r') as f:
    redundant_colors = f.read().strip().split('\n')

with open(minimal_cuts_file, 'r') as f:
    minimal_cuts = f.read().strip().split('\n')

# print(len(redundant_colors))
# print(len(minimal_cuts))

# Create a mapping from the unique vectors to minimal_cuts output
vector_to_cutsoutput = {
    identifiers: result
    for identifiers, result in zip(redundant_colors, minimal_cuts)
}

# Prepare output
output_lines = []
for identifiers in redundant_colors:
    result = vector_to_cutsoutput[identifiers]
    for identifier in identifiers.split(','):
        output_lines.append(f"{identifier}\t{result}")

# Write output
with open(output, 'w') as f:
    f.write('\n'.join(output_lines))
