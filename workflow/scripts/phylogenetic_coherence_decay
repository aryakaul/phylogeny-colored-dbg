#!/usr/bin/env python3
"""Phylogenetic coherence decay along graph walks.

Measures how rapidly phylogenetic assignment (cut-string) changes as
you walk outward from a unitig in the compacted colored de Bruijn graph.

For a sample of seed unitigs, BFS explores neighbors up to ``--max-hops``
edges away.  At each hop distance *h*, the fraction of reached unitigs
that share the seed's phylogenetic assignment is recorded ("coherence").

Two coherence definitions are reported:

- **Strict**: cut-strings must be identical as strings.
- **Containment**: for at least one pair of alternative solutions,
  one node-set is a subset of (or equal to) the other.  This captures
  unitigs that share a primary evolutionary event but differ in secondary
  refinements (e.g., partial loss within a subclade).

A null expectation for each definition is reported as a baseline.
"""

from __future__ import annotations

import argparse
import sqlite3
import sys
import time
from collections import defaultdict
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path
from typing import Dict, FrozenSet, List, Sequence, Tuple

import numpy as np
from loguru import logger


# ---------------------------------------------------------------------------
# Logger
# ---------------------------------------------------------------------------

def _configure_logger(verbosity: int) -> None:
    """0 → WARNING, 1 → INFO, 2+ → DEBUG."""
    logger.remove()
    level = "WARNING" if verbosity == 0 else (
        "INFO" if verbosity == 1 else "DEBUG")
    logger.add(sys.stderr, level=level)


# ---------------------------------------------------------------------------
# Cut-string parsing
# ---------------------------------------------------------------------------

def _parse_cutstring(cs: str) -> List[FrozenSet[str]]:
    """Parse a cut-string into a list of alternative solution sets.

    Rules:
        "NodeA"             → [{NodeA}]
        "NodeA,NodeB"       → [{NodeA, NodeB}]
        "NodeA OR NodeB,NodeC" → [{NodeA}, {NodeB, NodeC}]
    """
    if not cs or cs == "None":
        return [frozenset()]
    alternatives = cs.split(" OR ")
    solutions = []
    for alt in alternatives:
        nodes = frozenset(n.strip() for n in alt.split(",") if n.strip())
        solutions.append(nodes)
    return solutions


def _containment_check(
    sols_a: List[FrozenSet[str]],
    sols_b: List[FrozenSet[str]],
) -> bool:
    """True if any pair of solutions satisfies set containment."""
    for sa in sols_a:
        for sb in sols_b:
            if sa <= sb or sb <= sa:
                return True
    return False


# ---------------------------------------------------------------------------
# Graph loading
# ---------------------------------------------------------------------------

def _load_graph_and_colors(
    db_path: Path,
) -> Tuple[Dict[str, List[str]], Dict[str, str]]:
    """Load adjacency list and cut-string assignments from SQLite.

    The graph is treated as **undirected**: for every (A→B) edge we also
    record (B→A), and strand orientation is ignored.

    Returns:
        adj    -- adj[uid] = list of neighbor uids (undirected)
        colors -- colors[uid] = raw cut-string (or "None")
    """
    conn = sqlite3.connect(db_path)

    # Adjacency → undirected
    adj: Dict[str, List[str]] = defaultdict(list)
    for uid, _, nid, _ in conn.execute(
        "SELECT unitig_id, unitig_direction, "
        "neighbor_id, neighbor_direction FROM adjacency"
    ):
        adj[uid].append(nid)
        adj[nid].append(uid)

    # Cut-strings
    colors: Dict[str, str] = {}
    for uid, cs in conn.execute("SELECT unitig_id, colors FROM unitigs"):
        colors[uid] = cs if cs else "None"

    conn.close()

    # Ensure every unitig in colors has an adjacency entry (isolated nodes)
    for uid in colors:
        if uid not in adj:
            adj[uid] = []

    logger.info(
        "Graph loaded: {:,} unitigs, {:,} undirected adjacency entries",
        len(colors), sum(len(v) for v in adj.values()))
    return dict(adj), colors


# ---------------------------------------------------------------------------
# Precompute coherence lookup
# ---------------------------------------------------------------------------

def _build_containment_table(
    colors: Dict[str, str],
) -> Tuple[List[str], Dict[str, int], np.ndarray | None]:
    """Build pairwise containment coherence table for unique cut-strings.

    Strict coherence is just index equality (unique strings are unique by
    construction), so no table is needed for it.

    Returns:
        unique_cuts   -- list of M unique cut-strings
        cut_to_idx    -- mapping from cut-string to index in unique_cuts
        contain_table -- M×M bool array (set containment), or None if M > 50,000
    """
    # Collect unique cut-strings
    cut_counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        cut_counts[cs] += 1

    unique_cuts = list(cut_counts.keys())
    cut_to_idx = {cs: i for i, cs in enumerate(unique_cuts)}
    M = len(unique_cuts)

    logger.info("Unique cut-strings: {:,}", M)

    if M > 50_000:
        logger.warning(
            "M = {:,} > 50,000; skipping precompute of M² containment table. "
            "Will use on-the-fly checks (slower BFS).", M)
        return unique_cuts, cut_to_idx, None

    # Pre-parse all cut-strings
    parsed = [_parse_cutstring(cs) for cs in unique_cuts]

    # Build containment table
    contain_table = np.eye(M, dtype=np.bool_)

    t0 = time.time()
    for i in range(M):
        for j in range(i + 1, M):
            if _containment_check(parsed[i], parsed[j]):
                contain_table[i, j] = True
                contain_table[j, i] = True

    elapsed = time.time() - t0
    n_contain = int(contain_table.sum()) - M  # exclude diagonal
    logger.info(
        "Containment table built in {:.1f}s: {:,} coherent pairs "
        "(of {:,} off-diagonal)", elapsed, n_contain // 2, M * (M - 1) // 2)

    return unique_cuts, cut_to_idx, contain_table


# ---------------------------------------------------------------------------
# BFS coherence measurement
# ---------------------------------------------------------------------------

def _bfs_coherence(
    seed: str,
    adj: Dict[str, List[str]],
    unitig_to_cut_idx: Dict[str, int],
    max_hops: int,
    contain_table: np.ndarray | None,
    parsed_cuts: List[List[FrozenSet[str]]] | None,
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """BFS from *seed* up to *max_hops*, counting concordant neighbours.

    Returns three int arrays of length max_hops (index 0 = hop 1):
        n_reached           -- total unitigs reached at each hop distance
        n_strict_concordant -- strict equality (index identity)
        n_contain_concordant -- set containment matches
    """
    seed_idx = unitig_to_cut_idx.get(seed)
    n_reached = np.zeros(max_hops, dtype=np.int64)
    n_strict = np.zeros(max_hops, dtype=np.int64)
    n_contain = np.zeros(max_hops, dtype=np.int64)

    if seed_idx is None:
        return n_reached, n_strict, n_contain

    if contain_table is not None:
        seed_contain_row = contain_table[seed_idx]
    else:
        seed_parsed = parsed_cuts[seed_idx]

    visited = {seed}
    frontier = [seed]

    for h in range(max_hops):
        next_frontier: List[str] = []
        for uid in frontier:
            for nb in adj.get(uid, []):
                if nb not in visited:
                    visited.add(nb)
                    next_frontier.append(nb)
                    n_reached[h] += 1
                    nb_idx = unitig_to_cut_idx.get(nb)
                    if nb_idx is None:
                        continue
                    if nb_idx == seed_idx:
                        n_strict[h] += 1
                        n_contain[h] += 1
                    elif contain_table is not None:
                        if seed_contain_row[nb_idx]:
                            n_contain[h] += 1
                    else:
                        if _containment_check(seed_parsed, parsed_cuts[nb_idx]):
                            n_contain[h] += 1
        frontier = next_frontier
        if not frontier:
            break

    return n_reached, n_strict, n_contain


# ---------------------------------------------------------------------------
# Worker function for multiprocessing
# ---------------------------------------------------------------------------

def _worker_bfs(args_tuple):
    """Process a batch of seeds. Called by ProcessPoolExecutor."""
    (seeds, adj, unitig_to_cut_idx, max_hops,
     contain_table, parsed_cuts, worker_id) = args_tuple

    total_reached = np.zeros(max_hops, dtype=np.int64)
    total_strict = np.zeros(max_hops, dtype=np.int64)
    total_contain = np.zeros(max_hops, dtype=np.int64)

    for i, s in enumerate(seeds):
        reached, strict, contain = _bfs_coherence(
            s, adj, unitig_to_cut_idx, max_hops,
            contain_table, parsed_cuts)
        total_reached += reached
        total_strict += strict
        total_contain += contain

        if (i + 1) % 1000 == 0:
            logger.info(
                "Worker {}: BFS {}/{} seeds ({:.0f}%)",
                worker_id, i + 1, len(seeds), (i + 1) / len(seeds) * 100)

    return total_reached, total_strict, total_contain


# ---------------------------------------------------------------------------
# Null expectations
# ---------------------------------------------------------------------------

def _simpson_index(colors: Dict[str, str]) -> float:
    """Probability two randomly chosen unitigs have the same cut-string.

    This is Σ fᵢ² (Simpson's index / Herfindahl index), where fᵢ is the
    relative frequency of the i-th unique cut-string.
    """
    total = len(colors)
    if total == 0:
        return 0.0
    counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        counts[cs] += 1
    return sum((c / total) ** 2 for c in counts.values())


def _containment_null(
    colors: Dict[str, str],
    unique_cuts: List[str],
    contain_table: np.ndarray | None,
    parsed_cuts: List[List[FrozenSet[str]]] | None,
) -> float:
    """Null expectation for containment coherence: Σ_{i,j coherent} f_i * f_j."""
    total = len(colors)
    if total == 0:
        return 0.0

    counts: Dict[str, int] = defaultdict(int)
    for cs in colors.values():
        counts[cs] += 1

    freqs = np.array([counts[cs] / total for cs in unique_cuts])

    if contain_table is not None:
        # Vectorized: f^T @ C @ f
        return float(freqs @ contain_table.astype(np.float64) @ freqs)

    # On-the-fly fallback
    M = len(unique_cuts)
    null_val = 0.0
    for i in range(M):
        null_val += freqs[i] * freqs[i]  # diagonal (i == j)
        for j in range(i + 1, M):
            if _containment_check(parsed_cuts[i], parsed_cuts[j]):
                null_val += 2.0 * freqs[i] * freqs[j]
    return null_val


# ---------------------------------------------------------------------------
# Plotting
# ---------------------------------------------------------------------------

def _plot_decay(
    hops: np.ndarray,
    coherence_strict: np.ndarray,
    coherence_contain: np.ndarray,
    null_strict: float,
    null_contain: float,
    output_path: Path,
) -> None:
    """Save a coherence-decay plot (SVG)."""
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    import seaborn as sns

    sns.set_theme(style="white", context="notebook")
    fig, ax = plt.subplots(figsize=(7, 4.5))

    ax.plot(hops, coherence_contain, marker="o", linewidth=1.5,
            markersize=4, label="Containment coherence", color="tab:blue")
    ax.plot(hops, coherence_strict, marker="s", linewidth=1.5,
            markersize=3, linestyle="--", label="Strict coherence",
            color="tab:orange")
    ax.axhline(null_contain, color="tab:blue", linestyle=":", linewidth=1,
               alpha=0.7, label=f"Null containment = {null_contain:.4f}")
    ax.axhline(null_strict, color="tab:orange", linestyle=":", linewidth=1,
               alpha=0.7, label=f"Null strict = {null_strict:.4f}")

    ax.set_xlabel("Hop distance")
    ax.set_ylabel("Coherence fraction")
    ax.set_title("Phylogenetic coherence decay")
    ax.set_ylim(bottom=0)
    ax.legend()
    sns.despine(ax=ax, top=True, right=True)
    fig.tight_layout()
    fig.savefig(output_path, format="svg")
    plt.close(fig)
    logger.info("Plot saved to {}", output_path)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv: Sequence[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description="Phylogenetic coherence decay along graph walks.")
    parser.add_argument(
        "--db", type=Path, required=True,
        help="SQLite database with unitigs and adjacency tables.")
    parser.add_argument(
        "--max-hops", type=int, default=20,
        help="Maximum BFS walk distance (default: 20).")
    parser.add_argument(
        "--samples", type=int, default=10_000,
        help="Number of seed unitigs to sample (default: 10000).")
    parser.add_argument(
        "--seed", type=int, default=42,
        help="Random seed for reproducibility (default: 42).")
    parser.add_argument(
        "--output", type=Path, required=True,
        help="Output TSV path.")
    parser.add_argument(
        "--plot", type=Path, default=None,
        help="Optional path for an SVG decay-curve plot.")
    parser.add_argument(
        "--jobs", type=int, default=1,
        help="Number of parallel workers (default: 1).")
    parser.add_argument(
        "-v", "--verbose", action="count", default=0,
        help="Increase verbosity (-v for INFO, -vv for DEBUG).")

    args = parser.parse_args(argv)
    _configure_logger(args.verbose)

    # -- Load graph ----------------------------------------------------------
    adj, colors = _load_graph_and_colors(args.db)

    # -- Build containment lookup table --------------------------------------
    unique_cuts, cut_to_idx, contain_table = \
        _build_containment_table(colors)

    # Map unitigs to cut-string indices
    unitig_to_cut_idx: Dict[str, int] = {}
    for uid, cs in colors.items():
        unitig_to_cut_idx[uid] = cut_to_idx[cs]

    # Pre-parse for on-the-fly mode (when M > 50k, no precomputed table)
    parsed_cuts: List[List[FrozenSet[str]]] | None = None
    if contain_table is None:
        parsed_cuts = [_parse_cutstring(cs) for cs in unique_cuts]

    # -- Select seeds --------------------------------------------------------
    rng = np.random.default_rng(args.seed)
    all_unitigs = list(colors.keys())
    n_seeds = min(args.samples, len(all_unitigs))
    if n_seeds == len(all_unitigs):
        seeds = all_unitigs
        logger.info("Using all {:,} unitigs as seeds", n_seeds)
    else:
        seed_indices = rng.choice(len(all_unitigs), size=n_seeds, replace=False)
        seeds = [all_unitigs[i] for i in seed_indices]
        logger.info("Sampled {:,} seed unitigs", n_seeds)

    # -- BFS from each seed --------------------------------------------------
    t0 = time.time()
    n_jobs = max(1, args.jobs)

    if n_jobs == 1:
        # Single-threaded: run directly
        total_reached, total_strict, total_contain = _worker_bfs(
            (seeds, adj, unitig_to_cut_idx, args.max_hops,
             contain_table, parsed_cuts, 0))
    else:
        # Partition seeds across workers
        chunks = np.array_split(seeds, n_jobs)
        worker_args = [
            (list(chunk), adj, unitig_to_cut_idx, args.max_hops,
             contain_table, parsed_cuts, i)
            for i, chunk in enumerate(chunks) if len(chunk) > 0
        ]

        total_reached = np.zeros(args.max_hops, dtype=np.int64)
        total_strict = np.zeros(args.max_hops, dtype=np.int64)
        total_contain = np.zeros(args.max_hops, dtype=np.int64)

        with ProcessPoolExecutor(max_workers=n_jobs) as executor:
            for reached, strict, contain in executor.map(
                _worker_bfs, worker_args
            ):
                total_reached += reached
                total_strict += strict
                total_contain += contain

    logger.info(
        "BFS complete: {:,} seeds in {:.1f}s", n_seeds, time.time() - t0)

    # -- Compute coherence and null ------------------------------------------
    with np.errstate(divide="ignore", invalid="ignore"):
        coherence_strict = np.where(
            total_reached > 0,
            total_strict / total_reached,
            np.nan)
        coherence_contain = np.where(
            total_reached > 0,
            total_contain / total_reached,
            np.nan)

    null_strict = _simpson_index(colors)
    null_contain = _containment_null(
        colors, unique_cuts, contain_table, parsed_cuts)

    logger.info("Null strict (Simpson index): {:.6f}", null_strict)
    logger.info("Null containment: {:.6f}", null_contain)

    # -- Write output --------------------------------------------------------
    args.output.parent.mkdir(parents=True, exist_ok=True)
    hops = np.arange(1, args.max_hops + 1)

    with args.output.open("w") as out:
        out.write("hop_distance\tn_pairs\tstrict_coherence\t"
                  "containment_coherence\tnull_strict\tnull_containment\n")
        for h in range(args.max_hops):
            s_str = f"{coherence_strict[h]:.6f}" if not np.isnan(coherence_strict[h]) else "NA"
            c_str = f"{coherence_contain[h]:.6f}" if not np.isnan(coherence_contain[h]) else "NA"
            out.write(
                f"{hops[h]}\t{total_reached[h]}\t{s_str}\t"
                f"{c_str}\t{null_strict:.6f}\t{null_contain:.6f}\n")

    logger.info("Output written to {}", args.output)

    # -- Plot ----------------------------------------------------------------
    if args.plot is not None:
        valid = ~np.isnan(coherence_strict) & ~np.isnan(coherence_contain)
        if np.any(valid):
            args.plot.parent.mkdir(parents=True, exist_ok=True)
            _plot_decay(
                hops[valid], coherence_strict[valid], coherence_contain[valid],
                null_strict, null_contain, args.plot)
        else:
            logger.warning("No valid coherence data to plot")

    # -- Summary to stderr ---------------------------------------------------
    print("\n--- Phylogenetic Coherence Decay ---", file=sys.stderr)
    print(f"Seeds:                {n_seeds:,}", file=sys.stderr)
    print(f"Max hops:             {args.max_hops}", file=sys.stderr)
    print(f"Unique cut-strings:   {len(unique_cuts):,}", file=sys.stderr)
    print(f"Null strict:          {null_strict:.6f}", file=sys.stderr)
    print(f"Null containment:     {null_contain:.6f}", file=sys.stderr)
    if not np.isnan(coherence_strict[0]):
        print(f"Strict (h=1):         {coherence_strict[0]:.6f}", file=sys.stderr)
        print(f"Containment (h=1):    {coherence_contain[0]:.6f}", file=sys.stderr)
    # Find hop where each curve first drops below its null
    cross_s = np.where((coherence_strict <= null_strict) & ~np.isnan(coherence_strict))[0]
    cross_c = np.where((coherence_contain <= null_contain) & ~np.isnan(coherence_contain))[0]
    print(f"Strict crosses null:  "
          f"{'hop ' + str(hops[cross_s[0]]) if len(cross_s) > 0 else 'never (within max-hops)'}",
          file=sys.stderr)
    print(f"Contain crosses null: "
          f"{'hop ' + str(hops[cross_c[0]]) if len(cross_c) > 0 else 'never (within max-hops)'}",
          file=sys.stderr)
    print("------------------------------------", file=sys.stderr)


if __name__ == "__main__":
    main()
