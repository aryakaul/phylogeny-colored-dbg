#!/usr/bin/env python3
"""Stratified concordance breakpoints with permutation null model.

Replaces the binary concordant/discordant call from
``concordance_breakpoints`` with:

1. A **continuous tree-distance** metric between adjacent unitigs'
   phylogenetic assignments (cut-strings).
2. A **normalized distance** (tree_distance / tree_diameter).
3. A **permutation p-value** from a null model where cut-string labels
   are shuffled across unitigs, preserving the overall frequency
   distribution.

Cut-strings are read from the SQLite ``colors`` column (not the GFA's
``LB:Z:`` tag, which stores the same data but whose name suggests a hex
color — using the DB avoids confusion and is faster).

Distance between two assignments handles three cases:

- **Single node vs single node** (vast majority): direct lookup in a
  precomputed N×N node distance matrix (N = named tree nodes, ~2000).
  This is the fast path and is fully vectorized with numpy.
- **Multi-cut solutions** (e.g. "NodeA,NodeB" vs "NodeC"): directed
  Hausdorff averaged — for each node in set A find its nearest in B,
  average, then vice versa, then average both directions.
- **OR-ambiguous** (e.g. "X OR Y,Z"): minimum distance across all
  pairwise combinations of alternative solutions.

The permutation test is parallelized across ``--jobs`` workers using
fork-based multiprocessing (shared read-only data via copy-on-write).
"""

from __future__ import annotations

import argparse
import multiprocessing as mp
import sqlite3
import sys
import time
from collections import defaultdict, deque
from pathlib import Path
from typing import Dict, FrozenSet, List, Sequence, Tuple

import numpy as np
from ete4 import Tree
from loguru import logger

# Distances are quantized to int(d * _Q) for the permutation histogram.
# 0.01 resolution covers all Hausdorff-average fractional values.
_Q = 100


# ---------------------------------------------------------------------------
# Logger
# ---------------------------------------------------------------------------

def _configure_logger(verbosity: int) -> None:
    """0 → WARNING, 1 → INFO, 2+ → DEBUG."""
    logger.remove()
    level = "WARNING" if verbosity == 0 else (
        "INFO" if verbosity == 1 else "DEBUG")
    logger.add(sys.stderr, level=level)


# ---------------------------------------------------------------------------
# Tree: pairwise topological distances via BFS
# ---------------------------------------------------------------------------

def _build_node_distances(
    tree: Tree,
) -> Tuple[Dict[str, Dict[str, int]], List[str], np.ndarray, int]:
    """Pairwise topological distances between all named tree nodes.

    Returns:
        dist_dict  -- dist_dict[a][b] = number of edges on the a→b path
        node_names -- sorted list of named node names
        dist_np    -- N×N int16 numpy array of pairwise distances
        diam       -- max(dist[a][b]) across all named pairs
    """
    # Assign stable keys to all nodes (name, or placeholder for unnamed)
    node_key: Dict[int, str] = {}
    named_keys: set[str] = set()
    for node in tree.traverse():
        key = node.name if node.name else f"__anon_{id(node)}"
        node_key[id(node)] = key
        if node.name:
            named_keys.add(key)

    # Undirected adjacency (parent ↔ child)
    adj: Dict[str, List[str]] = defaultdict(list)
    for node in tree.traverse():
        pk = node_key[id(node)]
        for child in node.children:
            ck = node_key[id(child)]
            adj[pk].append(ck)
            adj[ck].append(pk)

    # BFS from every named node
    dist_dict: Dict[str, Dict[str, int]] = {}
    for start in sorted(named_keys):
        visited = {start: 0}
        queue: deque[str] = deque([start])
        while queue:
            cur = queue.popleft()
            for nb in adj[cur]:
                if nb not in visited:
                    visited[nb] = visited[cur] + 1
                    queue.append(nb)
        dist_dict[start] = {
            k: v for k, v in visited.items() if k in named_keys
        }

    diam = max(
        (d for row in dist_dict.values() for d in row.values()), default=0)

    # Build numpy matrix
    node_names = sorted(named_keys)
    name_to_idx = {n: i for i, n in enumerate(node_names)}
    N = len(node_names)
    dist_np = np.zeros((N, N), dtype=np.int16)
    for a, row in dist_dict.items():
        ai = name_to_idx[a]
        for b, d in row.items():
            dist_np[ai, name_to_idx[b]] = d

    logger.info(
        "Node distances: {} named nodes, diameter = {}", N, diam)
    return dist_dict, node_names, dist_np, diam


# ---------------------------------------------------------------------------
# Cut-string parsing and classification
# ---------------------------------------------------------------------------

def _parse_cutstring(raw: str) -> List[FrozenSet[str]]:
    """Parse a raw cut-string into a list of alternative solutions.

    Each solution is a frozenset of node names (the cut-points).

    Examples::

        "NodeA"            → [frozenset({"NodeA"})]
        "NodeA,NodeB"      → [frozenset({"NodeA", "NodeB"})]
        "A OR B,C"         → [frozenset({"A"}), frozenset({"B", "C"})]
        "Root"             → [frozenset({"Root"})]
        "None" / ""        → []  (unassigned)
    """
    if not raw or raw.strip().lower() == "none":
        return []
    alts: List[FrozenSet[str]] = []
    for option in raw.split(" OR "):
        nodes = frozenset(n.strip() for n in option.split(",") if n.strip())
        if nodes:
            alts.append(nodes)
    return alts


def _classify_cutstrings(
    unique_cs: List[str],
    name_to_nidx: Dict[str, int],
) -> Tuple[np.ndarray, np.ndarray, List[List[FrozenSet[str]]]]:
    """Classify cut-strings as simple (single tree node) or complex.

    Returns:
        is_simple      -- bool array [U], True if single-node cut-string
        simple_node_idx -- int32 array [U], tree-node index if simple, -1 otherwise
        parsed_cs      -- parsed form of each unique cut-string
    """
    U = len(unique_cs)
    is_simple = np.zeros(U, dtype=np.bool_)
    simple_node_idx = np.full(U, -1, dtype=np.int32)
    parsed_cs = []

    for i, cs in enumerate(unique_cs):
        p = _parse_cutstring(cs)
        parsed_cs.append(p)
        if len(p) == 1 and len(p[0]) == 1:
            node_name = next(iter(p[0]))
            nidx = name_to_nidx.get(node_name)
            if nidx is not None:
                is_simple[i] = True
                simple_node_idx[i] = nidx

    n_simple = int(is_simple.sum())
    logger.info(
        "Cut-string classification: {:,} simple ({:.1f}%), {:,} complex",
        n_simple, 100.0 * n_simple / max(U, 1), U - n_simple)
    return is_simple, simple_node_idx, parsed_cs


# ---------------------------------------------------------------------------
# Distance between assignments
# ---------------------------------------------------------------------------

def _solution_distance(
    sol_a: FrozenSet[str],
    sol_b: FrozenSet[str],
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> float:
    """Distance between two single solutions (each a set of cut-nodes).

    Returns -1.0 if any node is absent from the distance matrix.
    """
    if sol_a == sol_b:
        return 0.0

    idx_a = [name_to_nidx.get(n) for n in sol_a]
    idx_b = [name_to_nidx.get(n) for n in sol_b]

    if any(i is None for i in idx_a) or any(i is None for i in idx_b):
        return -1.0

    # Fast path: single vs single
    if len(idx_a) == 1 and len(idx_b) == 1:
        return float(node_dist_np[idx_a[0], idx_b[0]])

    # General case: directed Hausdorff averaged
    ia = np.array(idx_a, dtype=np.int32)
    ib = np.array(idx_b, dtype=np.int32)
    sub = node_dist_np[np.ix_(ia, ib)].astype(np.float64)
    d_ab = float(sub.min(axis=1).mean())
    d_ba = float(sub.min(axis=0).mean())
    return (d_ab + d_ba) / 2.0


def _assignment_distance(
    alts_a: List[FrozenSet[str]],
    alts_b: List[FrozenSet[str]],
    node_dist_np: np.ndarray,
    name_to_nidx: Dict[str, int],
) -> float:
    """Distance between two full assignments, handling OR-ambiguity."""
    # Quick concordance check: shared alternative
    set_a = set(alts_a)
    if any(sb in set_a for sb in alts_b):
        return 0.0

    best = float("inf")
    for sa in alts_a:
        for sb in alts_b:
            d = _solution_distance(sa, sb, node_dist_np, name_to_nidx)
            if 0 <= d < best:
                best = d
    return best if best < float("inf") else -1.0


def _compute_edge_distances(
    cs_a: np.ndarray,
    cs_b: np.ndarray,
    is_simple: np.ndarray,
    simple_node_idx: np.ndarray,
    node_dist_np: np.ndarray,
    parsed_cs: List[List[FrozenSet[str]]],
    name_to_nidx: Dict[str, int],
) -> np.ndarray:
    """Compute tree distances for edges, vectorized where possible.

    Args:
        cs_a, cs_b: cut-string indices for each edge endpoint [E]

    Returns:
        dists: float32 array [E], -1.0 for invalid distances
    """
    E = len(cs_a)
    dists = np.full(E, -1.0, dtype=np.float32)

    # Same cut-string → distance 0
    same = cs_a == cs_b
    dists[same] = 0.0

    # Both simple → vectorized N×N lookup
    both_simple = is_simple[cs_a] & is_simple[cs_b] & ~same
    if both_simple.any():
        na = simple_node_idx[cs_a[both_simple]]
        nb = simple_node_idx[cs_b[both_simple]]
        dists[both_simple] = node_dist_np[na, nb].astype(np.float32)

    # Complex pairs: Python loop
    need_complex = ~same & ~both_simple
    for idx in np.where(need_complex)[0]:
        p_a = parsed_cs[cs_a[idx]]
        p_b = parsed_cs[cs_b[idx]]
        if p_a and p_b:
            dists[idx] = _assignment_distance(
                p_a, p_b, node_dist_np, name_to_nidx)

    return dists


# ---------------------------------------------------------------------------
# Shared state for fork-based multiprocessing
# ---------------------------------------------------------------------------

_SHARED: Dict = {}


# ---------------------------------------------------------------------------
# Permutation null model
# ---------------------------------------------------------------------------

def _permutation_worker(args_tuple):
    """Run a batch of permutations. Reads shared data from _SHARED."""
    perm_start, perm_end, seed = args_tuple

    assignment_indices = _SHARED["assignment_indices"]
    edge_a_idx = _SHARED["edge_a_idx"]
    edge_b_idx = _SHARED["edge_b_idx"]
    is_simple = _SHARED["is_simple"]
    simple_node_idx = _SHARED["simple_node_idx"]
    node_dist_np = _SHARED["node_dist_np"]
    parsed_cs = _SHARED["parsed_cs"]
    name_to_nidx = _SHARED["name_to_nidx"]
    max_q = _SHARED["max_q"]

    rng = np.random.default_rng(seed)
    hist = np.zeros(max_q + 1, dtype=np.int64)
    total_valid = 0
    total_sum = 0.0

    for p in range(perm_start, perm_end):
        perm = assignment_indices.copy()
        rng.shuffle(perm)

        cs_a = perm[edge_a_idx]
        cs_b = perm[edge_b_idx]
        dists = _compute_edge_distances(
            cs_a, cs_b, is_simple, simple_node_idx,
            node_dist_np, parsed_cs, name_to_nidx)

        valid_mask = dists >= 0
        valid_dists = dists[valid_mask]

        quantized = np.clip(
            (valid_dists * _Q + 0.5).astype(np.int64), 0, max_q)
        hist += np.bincount(quantized, minlength=max_q + 1)
        total_valid += int(valid_mask.sum())
        total_sum += float(valid_dists.sum())

        n_done = p - perm_start + 1
        if n_done % 100 == 0:
            logger.info(
                "Permutation worker: {}/{}", n_done, perm_end - perm_start)

    return hist, total_valid, total_sum


def _run_permutation_test(
    n_permutations: int,
    n_jobs: int,
    max_dist: float,
    rng: np.random.Generator,
) -> Tuple[np.ndarray, float]:
    """Permutation null model for edge tree-distances.

    Returns:
        survival   -- survival[q] = P(permuted_distance ≥ q/_Q).
                      Index with int(round(distance * _Q)).
        mean_perm  -- mean distance across all valid permuted edges.
    """
    max_q = int(max_dist * _Q) + 1
    _SHARED["max_q"] = max_q

    # Assign each worker a contiguous range of permutations + unique seed
    chunk_size = (n_permutations + n_jobs - 1) // n_jobs
    worker_args = []
    for i in range(n_jobs):
        start = i * chunk_size
        end = min(start + chunk_size, n_permutations)
        if start >= end:
            break
        worker_seed = int(rng.integers(0, 2**62))
        worker_args.append((start, end, worker_seed))

    if n_jobs == 1:
        hist, total_valid, total_sum = _permutation_worker(worker_args[0])
    else:
        hist = np.zeros(max_q + 1, dtype=np.int64)
        total_valid = 0
        total_sum = 0.0

        ctx = mp.get_context("fork")
        with ctx.Pool(n_jobs) as pool:
            for w_hist, w_valid, w_sum in pool.imap_unordered(
                _permutation_worker, worker_args
            ):
                hist += w_hist
                total_valid += w_valid
                total_sum += w_sum

    # Survival function: P(distance ≥ threshold)
    survival = np.cumsum(hist[::-1])[::-1].astype(np.float64)
    if total_valid > 0:
        survival /= total_valid
        mean_perm = total_sum / total_valid
    else:
        mean_perm = 0.0

    return survival, mean_perm


def _lookup_pvalue(distance: float, survival: np.ndarray) -> float:
    """Map an observed distance to its permutation p-value."""
    q = int(round(distance * _Q))
    if q < 0:
        return float("nan")
    if q >= len(survival):
        return 0.0
    return float(survival[q])


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main(argv: Sequence[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Stratified concordance breakpoints with permutation null model."
        ))
    parser.add_argument(
        "--gfa", type=Path, required=True,
        help="Colored GFA1 file (accepted for pipeline compatibility; "
             "data is read from --db).")
    parser.add_argument(
        "--tree", type=Path, required=True,
        help="Postprocessed Newick tree with named internal nodes.")
    parser.add_argument(
        "--db", type=Path, required=True,
        help="SQLite database with unitigs (colors) and adjacency tables.")
    parser.add_argument(
        "--permutations", type=int, default=1000,
        help="Number of label permutations for null model (default: 1000).")
    parser.add_argument(
        "--output", type=Path, required=True,
        help="Output TSV path.")
    parser.add_argument(
        "--seed", type=int, default=42,
        help="Random seed for reproducibility (default: 42).")
    parser.add_argument(
        "--jobs", type=int, default=1,
        help="Number of parallel workers (default: 1).")
    parser.add_argument(
        "-v", "--verbose", action="count", default=0,
        help="Increase verbosity (-v for INFO, -vv for DEBUG).")

    args = parser.parse_args(argv)
    _configure_logger(args.verbose)

    # -- Load tree and build node distances ----------------------------------
    logger.info("Loading tree from {}", args.tree)
    with args.tree.open() as fh:
        tree = Tree(fh.read(), parser=1)
    if not tree.name:
        tree.name = "Root"

    t0 = time.time()
    node_dist_dict, node_names, node_dist_np, diameter = \
        _build_node_distances(tree)
    name_to_nidx = {n: i for i, n in enumerate(node_names)}
    logger.info("Node distances computed in {:.1f}s", time.time() - t0)

    if diameter == 0:
        logger.error("Tree diameter is 0; cannot normalize distances.")
        sys.exit(1)

    # -- Load assignments and edges from SQLite ------------------------------
    logger.info("Loading data from {}", args.db)
    conn = sqlite3.connect(args.db)

    unitig_colors: Dict[str, str] = {}
    for uid, colors in conn.execute("SELECT unitig_id, colors FROM unitigs"):
        unitig_colors[uid] = colors if colors else "None"

    edges_raw: List[Tuple[str, str, str, str]] = list(conn.execute(
        "SELECT unitig_id, unitig_direction, neighbor_id, neighbor_direction "
        "FROM adjacency"))
    conn.close()

    logger.info(
        "Loaded {:,} unitigs, {:,} edges", len(unitig_colors), len(edges_raw))

    # -- Index: unitigs → integers, cut-strings → integers -------------------
    assigned_unitigs = {
        uid for uid, cs in unitig_colors.items()
        if cs.strip().lower() != "none" and cs.strip()
    }

    unique_cs = sorted({unitig_colors[uid] for uid in assigned_unitigs})
    cs_to_idx = {cs: i for i, cs in enumerate(unique_cs)}
    logger.info("{:,} unique non-None cut-strings", len(unique_cs))

    unitig_list = sorted(assigned_unitigs)
    unitig_to_flat = {uid: i for i, uid in enumerate(unitig_list)}
    assignment_indices = np.array(
        [cs_to_idx[unitig_colors[uid]] for uid in unitig_list],
        dtype=np.int32)

    # -- Classify cut-strings ------------------------------------------------
    t0 = time.time()
    is_simple, simple_node_idx, parsed_cs = \
        _classify_cutstrings(unique_cs, name_to_nidx)
    logger.info("Cut-strings classified in {:.1f}s", time.time() - t0)

    # -- Filter edges: both endpoints must be assigned -----------------------
    edge_a_flat: List[int] = []
    edge_b_flat: List[int] = []
    edge_meta: List[Tuple[str, str, str, str, str, str]] = []

    for uid_a, dir_a, uid_b, dir_b in edges_raw:
        if uid_a not in unitig_to_flat or uid_b not in unitig_to_flat:
            continue
        cs_a = unitig_colors[uid_a]
        cs_b = unitig_colors[uid_b]
        edge_a_flat.append(unitig_to_flat[uid_a])
        edge_b_flat.append(unitig_to_flat[uid_b])
        edge_meta.append((uid_a, dir_a, uid_b, dir_b, cs_a, cs_b))

    edge_a_idx = np.array(edge_a_flat, dtype=np.int32)
    edge_b_idx = np.array(edge_b_flat, dtype=np.int32)
    E = len(edge_meta)
    logger.info("{:,} edges with both endpoints assigned", E)

    # -- Observed distances --------------------------------------------------
    t0 = time.time()
    obs_cs_a = assignment_indices[edge_a_idx]
    obs_cs_b = assignment_indices[edge_b_idx]
    observed = _compute_edge_distances(
        obs_cs_a, obs_cs_b, is_simple, simple_node_idx,
        node_dist_np, parsed_cs, name_to_nidx)
    logger.info("Observed distances computed in {:.1f}s", time.time() - t0)

    n_valid = int(np.sum(observed >= 0))
    n_concordant = int(np.sum(observed == 0))
    n_discordant = int(np.sum(observed > 0))
    n_invalid = int(np.sum(observed < 0))
    mean_obs = (
        float(np.mean(observed[observed >= 0])) if n_valid > 0 else 0.0)

    logger.info(
        "Observed: {:,} valid, {:,} concordant, {:,} discordant, "
        "{:,} invalid",
        n_valid, n_concordant, n_discordant, n_invalid)

    # -- Permutation test ----------------------------------------------------
    rng = np.random.default_rng(args.seed)
    n_jobs = max(1, args.jobs)

    if args.permutations > 0 and E > 0:
        # Populate shared state before forking
        _SHARED["assignment_indices"] = assignment_indices
        _SHARED["edge_a_idx"] = edge_a_idx
        _SHARED["edge_b_idx"] = edge_b_idx
        _SHARED["is_simple"] = is_simple
        _SHARED["simple_node_idx"] = simple_node_idx
        _SHARED["node_dist_np"] = node_dist_np
        _SHARED["parsed_cs"] = parsed_cs
        _SHARED["name_to_nidx"] = name_to_nidx

        max_dist = float(node_dist_np.max())

        t0 = time.time()
        logger.info(
            "Running {:,} permutations across {} workers...",
            args.permutations, n_jobs)
        survival, mean_perm = _run_permutation_test(
            args.permutations, n_jobs, max_dist, rng)
        logger.info("Permutations done in {:.1f}s", time.time() - t0)
    else:
        survival = np.ones(1, dtype=np.float64)
        mean_perm = 0.0

    # -- Write output --------------------------------------------------------
    args.output.parent.mkdir(parents=True, exist_ok=True)

    columns = [
        "unitig_A", "dir_A", "unitig_B", "dir_B",
        "cutstring_A", "cutstring_B",
        "tree_distance", "normalized_distance",
        "concordant", "permutation_pvalue",
    ]

    n_written = 0
    with args.output.open("w") as out:
        out.write("\t".join(columns) + "\n")
        for i, (uid_a, dir_a, uid_b, dir_b, cs_a, cs_b) in enumerate(
                edge_meta):
            d = float(observed[i])
            if d < 0:
                continue  # skip edges with unresolvable distance
            norm_d = d / diameter
            concordant = "true" if d == 0 else "false"
            if args.permutations > 0:
                pval_str = f"{_lookup_pvalue(d, survival):.6g}"
            else:
                pval_str = "NA"
            out.write(
                f"{uid_a}\t{dir_a}\t{uid_b}\t{dir_b}\t"
                f"{cs_a}\t{cs_b}\t"
                f"{d:.4g}\t{norm_d:.6f}\t{concordant}\t{pval_str}\n")
            n_written += 1

    logger.info("Wrote {:,} scored edges to {}", n_written, args.output)

    # -- Summary to stderr ---------------------------------------------------
    print("\n--- Concordance Breakpoint Summary ---", file=sys.stderr)
    print(f"Total links (both assigned):  {E:,}", file=sys.stderr)
    print(f"  Concordant (distance = 0):  {n_concordant:,}", file=sys.stderr)
    print(f"  Discordant (distance > 0):  {n_discordant:,}", file=sys.stderr)
    if n_invalid:
        print(
            f"  Invalid (missing nodes):    {n_invalid:,}", file=sys.stderr)
    print(f"Mean observed tree distance:  {mean_obs:.4f}", file=sys.stderr)

    if args.permutations > 0 and E > 0:
        print(
            f"Mean permuted tree distance:  {mean_perm:.4f}", file=sys.stderr)
        sig_count = sum(
            1 for d in observed if d >= 0 and _lookup_pvalue(d, survival) < 0.05
        )
        frac_sig = sig_count / n_valid if n_valid > 0 else 0.0
        print(
            f"Fraction with p < 0.05:       {frac_sig:.4f} "
            f"({sig_count:,}/{n_valid:,})",
            file=sys.stderr)

    print("--------------------------------------", file=sys.stderr)


if __name__ == "__main__":
    main()
