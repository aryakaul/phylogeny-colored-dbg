#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import multiprocessing
import sqlite3
import sys
import time
from dataclasses import dataclass, field
from functools import lru_cache, partial
from pathlib import Path
from typing import Dict, Iterable, Iterator, List, Sequence, Tuple

from loguru import logger

from sql_utils import lookup_unitigs_batch


@dataclass
class SearchLimits:
    """Track recursion guardrails for path enumeration."""

    bubble_id: str
    max_paths: int
    timeout_seconds: int | None
    start_time: float = field(default_factory=time.monotonic)
    emitted: int = 0
    warned_timeout: bool = False
    warned_cap: bool = False

    def should_continue(self) -> bool:
        if self.timeout_seconds is not None:
            elapsed = time.monotonic() - self.start_time
            if elapsed > self.timeout_seconds:
                if not self.warned_timeout:
                    logger.warning(
                        "Timed out enumerating paths for bubble {} after {:.1f}s",
                        self.bubble_id,
                        elapsed,
                    )
                    self.warned_timeout = True
                return False
        if self.max_paths and self.emitted >= self.max_paths:
            if not self.warned_cap:
                logger.warning(
                    "Reached max_paths={} while enumerating bubble {}",
                    self.max_paths,
                    self.bubble_id,
                )
                self.warned_cap = True
            return False
        return True

    def record_emission(self) -> None:
        self.emitted += 1


def read_bubbles(file_path: Path):
    """
    Reads the bubbles.json file and yields bubble objects.
    """
    with file_path.open("r") as f:
        bubbles = json.load(f)
        for chain_id, chain_data in bubbles.items():
            for bubble in chain_data["bubbles"]:
                yield bubble


def fetch_adjacency_data(
    conn: sqlite3.Connection, allowed_unitigs: Sequence[str]
) -> Dict[str, Dict[str, set]]:
    """Return adjacency information for a restricted set of unitigs."""

    allowed_set = {unitig for unitig in allowed_unitigs}
    if not allowed_set:
        return {}

    adjacency_dict: Dict[str, Dict[str, set]] = {
        unitig: {"+": set(), "-": set()} for unitig in allowed_set
    }
    metadata = lookup_unitigs_batch(conn, allowed_set, output_neighbors=True)

    for unitig_id, meta in metadata.items():
        neighbours = meta.get("neighbors", {})
        for orientation, entries in neighbours.items():
            if orientation not in ("+", "-"):
                continue
            adjacency_dict.setdefault(unitig_id, {"+": set(), "-": set()})
            adjacency_dict[unitig_id][orientation].update(
                (neighbor_id, neighbor_dir)
                for neighbor_id, neighbor_dir in entries
                if neighbor_id in allowed_set
            )

    return adjacency_dict


def find_paths_with_allowed_unitigs(
    bubble_id: str,
    adjacency_dict: Dict[str, Dict[str, Iterable[Tuple[str, str]]]],
    start: str,
    end: str,
    limits: SearchLimits,
) -> Iterator[List[str]]:
    """Depth-first search that respects timeout and path-count limits."""

    visited: List[str] = []
    seen: set[str] = set()

    def dfs(node: str) -> Iterator[List[str]]:
        if not limits.should_continue():
            return
        visited.append(node)
        seen.add(node)
        try:
            if node == end:
                limits.record_emission()
                yield list(visited)
                return

            unitig_id = node[:-1]
            orientation = node[-1]
            neighbors = adjacency_dict.get(unitig_id, {}).get(orientation, ())
            for neighbor_id, neighbor_dir in neighbors:
                next_node = f"{neighbor_id}{neighbor_dir}"
                if next_node in seen:
                    continue
                yield from dfs(next_node)
                if not limits.should_continue():
                    return
        finally:
            seen.remove(node)
            visited.pop()

    return dfs(start)


def filter_paths_by_criteria(
    conn,
    all_paths,
    smallpath_maxlen=100,
    bigpath_minlen=1000,
):
    valid_pairs = []

    logger.debug("Getting unitig ids")
    # Collect all unique unitig IDs from all paths
    all_unitig_ids = set(unitig_id[:-1] for path in all_paths
                         for unitig_id in path[1:-1])

    # Fetch unitig information in batch
    logger.debug("Looking up unitigs")
    unitig_info = lookup_unitigs_batch(conn, list(all_unitig_ids))

    # Modified to use cached parsed colors (if applicable)
    logger.debug("Finding colors of unitigs")
    for unitig_id in unitig_info:
        unitig_info[unitig_id]["parsed_colors"] = parse_colors(
            unitig_info[unitig_id]["colors"])

    # Pre-calculate path info (lengths and shared colors) and store them
    logger.debug("Getting lengths and shared colors of paths")
    path_info = []
    for path in all_paths:
        inner_path = path[1:-1]
        path_lengths = []
        color_sets = []
        missing_unitig = False
        for unitig in inner_path:
            metadata = unitig_info.get(unitig[:-1])
            if metadata is None:
                logger.debug(
                    "Skipping path containing unitig {} absent from SQLite metadata",
                    unitig,
                )
                missing_unitig = True
                break
            path_lengths.append(metadata["length"])
            color_sets.append(metadata["parsed_colors"])
        if missing_unitig:
            path_info.append([0, set()])
            continue
        lengths = path_lengths
        total_length = sum(lengths)
        shared_colors = get_shared_colors(color_sets)
        path_info.append([total_length, shared_colors])

    logger.debug("Segmenting into small and large paths")
    small_paths = [
        i for i, info in enumerate(path_info) if info[0] < smallpath_maxlen
    ]
    large_paths = [
        i for i, info in enumerate(path_info) if info[0] > bigpath_minlen
    ]

    logger.debug("Going through small and big path pairs")
    for i in small_paths:
        for j in large_paths:
            if path_info[i][1] & path_info[j][1]:
                valid_pairs.append((all_paths[i], all_paths[j]))
    logger.debug("Finished identifying valid pairs")
    return valid_pairs


def process_one_bubble(
    bubble: Dict[str, object],
    db_filepath: Path,
    smallpath_maxlen: int,
    bigpath_minlen: int,
    max_paths: int,
    timeout: int,
):
    unitigdb = sqlite3.connect(str(db_filepath))
    start, end = bubble["ends"]
    allowed_unitigs = list(bubble["inside"]) + list(bubble["ends"])
    logger.debug("Processing bubble {}", bubble["id"])
    adjacency_dict = fetch_adjacency_data(unitigdb, allowed_unitigs)
    logger.debug("Enumerating candidate paths for bubble {}", bubble["id"])

    limits = SearchLimits(
        bubble_id=bubble["id"],
        max_paths=max_paths,
        timeout_seconds=timeout if timeout > 0 else None,
    )
    orientation_pairs = []
    for source, target in ((start, end), (end, start)):
        for source_dir in ("+", "-"):
            if not limits.should_continue():
                break
            for target_dir in ("+", "-"):
                if not limits.should_continue():
                    break
                orientation_pairs.extend(
                    list(
                        find_paths_with_allowed_unitigs(
                            bubble["id"],
                            adjacency_dict,
                            f"{source}{source_dir}",
                            f"{target}{target_dir}",
                            limits,
                        )
                    )
                )
        if not limits.should_continue():
            break

    logger.debug(
        "Found {} potential paths for bubble {}", len(orientation_pairs), bubble["id"]
    )
    filtered_paths = filter_paths_by_criteria(
        unitigdb,
        orientation_pairs,
        smallpath_maxlen,
        bigpath_minlen,
    )
    unitigdb.close()

    # Add valid path pairs to the bubble object if any are found
    if filtered_paths:
        logger.info(
            f"{bubble['id']} identified as candidate with {len(filtered_paths)} possible path pairs"
        )
        bubble["valid_path_pairs"] = [([unitig for unitig in path_a],
                                       [unitig for unitig in path_b])
                                      for path_a, path_b in filtered_paths]
        return bubble
    else:
        return None


def filter_bubbles(
    bubble_path: Path,
    db_filepath: Path,
    smallpath_maxlen: int,
    bigpath_minlen: int,
    threads: int,
    maxpaths: int,
    timeout: int,
):
    passing_bubbles = []
    bubbles = read_bubbles(
        bubble_path)  # Assuming this returns an iterable of bubbles

    process_bubble_with_args = partial(
        process_one_bubble,
        db_filepath=db_filepath,
        smallpath_maxlen=smallpath_maxlen,
        bigpath_minlen=bigpath_minlen,
        max_paths=maxpaths,
        timeout=timeout,
    )

    if threads <= 1:
        for bubble in bubbles:
            result = process_bubble_with_args(bubble)
            if result is not None:
                passing_bubbles.append(result)
    else:
        with multiprocessing.Pool(processes=threads) as pool:
            for result in pool.imap_unordered(process_bubble_with_args, bubbles):
                if result is not None:
                    passing_bubbles.append(result)

    logger.info(f"Total number of passing bubbles: {len(passing_bubbles)}")
    return passing_bubbles


@lru_cache(maxsize=1024)
def parse_colors(color_string):
    if not color_string or color_string == "None":
        return [set()]
    color_options = color_string.split(" OR ")
    return [set(filter(None, option.split(","))) for option in color_options]


def get_shared_colors(list_of_color_options, shared_color_threshold=90):
    color_counts = {}
    total_unitigs = len(list_of_color_options)

    for color_options in list_of_color_options:
        for color_set in color_options:
            for color in color_set:
                color_counts[color] = color_counts.get(color, 0) + 1

    threshold_count = (shared_color_threshold / 100.0) * total_unitigs
    return {
        color
        for color, count in color_counts.items() if count >= threshold_count
    }


def get_shared_colors_exact(list_of_color_options):
    """
    Finds a set of colors that is present in the `shared_color_threshold`
    percent of color options of each unitig in the path. Each unitig could
    have multiple sets of colors, represented as a list of sets.
    """
    # Initialize shared colors as None
    shared_colors = None

    # Iterate through each unitig's color options
    for color_options in list_of_color_options:
        # Calculate the intersection of color options for the current unitig
        current_shared = set.union(*color_options) if color_options else set()

        # If it's the first unitig, set its colors as the initial shared colors
        if shared_colors is None:
            shared_colors = current_shared
        else:
            # Otherwise, intersect with the shared colors found so far
            shared_colors = shared_colors.intersection(current_shared)

        # If at any point there are no shared colors, return an empty set
        if not shared_colors:
            return set()

    return shared_colors


def dump_matching_bubbles(output_json_path: Path, matching_bubbles) -> None:
    output_json_path.parent.mkdir(parents=True, exist_ok=True)
    with output_json_path.open("w") as outfile:
        json.dump(matching_bubbles, outfile, indent=4)


def main():
    parser = argparse.ArgumentParser(
        description="Process minimal_cuts and BubbleGun output")

    parser.add_argument(
        "-b",
        "--bubblegun",
        type=str,
        required=True,
        help="The file path for the output of BubbleGun's JSON file.",
        metavar="FILE",
    )

    parser.add_argument(
        "-o",
        "--output",
        type=str,
        required=True,
        help="The file path for the output file.",
        metavar="FILE",
    )

    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help=
        "Increase verbosity level. Can be specified multiple times for more detailed logs.",
    )

    parser.add_argument(
        "-d",
        "--db",
        type=str,
        required=True,
        help=
        "Path to store unitig SQL3 database. Preferably on a filesystem with quick read/write access.",
    )

    parser.add_argument(
        "--predeletionsize",
        type=int,
        default=1000,
        help="Minimum size of the longer path (pre-deletion)",
    )

    parser.add_argument(
        "--postdeletionsize",
        type=int,
        default=100,
        help="Maximum size of the shorter path (post-deletion)",
    )

    parser.add_argument(
        "-m",
        "--maxpaths",
        type=int,
        default=100000,
        help="Max number of paths to find in each bubble. Default is 100,000",
    )

    parser.add_argument(
        "-to",
        "--timeout",
        type=int,
        default=3600,
        help=
        "Max time to try and find all paths in a bubble. Default is 3600 seconds (1 hour)",
    )

    parser.add_argument(
        "-j",
        "--threads",
        type=int,
        default=multiprocessing.cpu_count(),
        help=
        "Number of threads to use to analyze bubbles. Default is all available.",
    )

    # Parse the arguments
    args = parser.parse_args()

    if args.verbose == 0:
        logger.remove()
    elif args.verbose == 1:
        logger.remove()
        logger.add(sys.stderr, level="INFO")
    else:
        logger.remove()
        logger.add(sys.stderr, level="DEBUG")

    bubble_path = Path(args.bubblegun)
    db_path = Path(args.db)
    output_path = Path(args.output)

    if not bubble_path.is_file():
        logger.error("BubbleGun JSON file '{}' does not exist.", bubble_path)
        return
    if not db_path.is_file():
        logger.error("SQLite database '{}' does not exist.", db_path)
        return

    logger.info("Filtering bubbles from {}", bubble_path)
    matching_bubbles = filter_bubbles(
        bubble_path,
        db_path,
        args.postdeletionsize,
        args.predeletionsize,
        args.threads,
        args.maxpaths,
        args.timeout,
    )
    dump_matching_bubbles(output_path, matching_bubbles)
    logger.info("Filtered bubbles dumped to {}", output_path)


if __name__ == "__main__":
    main()
