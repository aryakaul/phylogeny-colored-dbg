#!/usr/bin/env python3
"""Build a cuttlefish unitig presence/absence matrix for pcDBG."""

from __future__ import annotations

import argparse
import sys
import time
from array import array
from pathlib import Path
from typing import Dict, List, Sequence, Tuple

import numpy as np
from loguru import logger
from scipy import sparse


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=
        "Convert cuttlefish GFA1 output to a unitig presence/absence matrix.")
    parser.add_argument(
        "gfa",
        type=Path,
        help="Path to the cuttlefish-generated GFA1 file.",
    )
    parser.add_argument(
        "fof",
        type=Path,
        help=
        "File-of-filenames enumerating the assemblies used for cuttlefish.",
    )
    parser.add_argument(
        "output",
        type=Path,
        help="Destination TSV file for the presence/absence matrix.",
    )
    parser.add_argument(
        "--chunk-size",
        type=int,
        default=5000,
        help="Number of unitig rows to materialise at once when writing the TSV "
        "(default: 5000).",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Increase logging verbosity (specify twice for DEBUG).",
    )
    return parser.parse_args(argv)


def configure_logging(verbosity: int) -> None:
    if verbosity <= 0:
        logger.remove()
    elif verbosity == 1:
        logger.remove()
        logger.add(sys.stderr, level="INFO")
    else:
        logger.remove()
        logger.add(sys.stderr, level="DEBUG")


def load_sample_paths(fof_path: Path) -> List[str]:
    samples: List[str] = []
    with fof_path.open("r") as handle:
        for raw in handle:
            entry = raw.strip()
            if entry:
                samples.append(entry)
    if not samples:
        raise ValueError(
            f"File-of-filenames '{fof_path}' does not contain any entries")
    logger.info("Loaded {} assemblies from {}", len(samples), fof_path)
    return samples


def strip_orientation(unitig: str) -> str:
    if unitig and unitig[-1] in "+-":
        return unitig[:-1]
    return unitig


def collect_presence_indices(
    gfa_path: Path,
    samples: Sequence[str],
) -> Tuple[List[str], array, array]:
    logger.info("Parsing GFA path lines from {}", gfa_path)
    t0 = time.monotonic()
    unitig_to_index: Dict[str, int] = {}
    unitig_ids: List[str] = []
    row_idx: array = array("I")
    col_idx: array = array("I")
    paths_parsed = 0

    with gfa_path.open("r") as handle:
        for line_number, raw in enumerate(handle, start=1):
            if not raw or raw[0] != "P":
                continue
            parts = raw.rstrip("\n").split()
            if len(parts) < 3:
                continue

            try:
                ref_seq_idx = int(parts[1].split("_")[0].split(":")[1]) - 1
            except (IndexError, ValueError) as exc:
                raise ValueError(
                    f"Failed to parse reference index from '{parts[1]}' on line {line_number}"
                ) from exc

            if not (0 <= ref_seq_idx < len(samples)):
                raise IndexError(
                    f"GFA references sample index {ref_seq_idx + 1}, "
                    f"but only {len(samples)} assemblies were provided")

            # Deduplicate unitigs within this path before recording indices.
            unitigs_in_path = {
                strip_orientation(token)
                for token in parts[2].split(",") if token
            }
            for unitig in unitigs_in_path:
                idx = unitig_to_index.get(unitig)
                if idx is None:
                    idx = len(unitig_ids)
                    unitig_to_index[unitig] = idx
                    unitig_ids.append(unitig)
                row_idx.append(idx)
                col_idx.append(ref_seq_idx)

            paths_parsed += 1
            if paths_parsed % 50_000 == 0:
                logger.info(
                    "  parsed {:,} paths ({:,} unique unitigs so far)",
                    paths_parsed,
                    len(unitig_ids),
                )

    elapsed = time.monotonic() - t0
    logger.info(
        "Parsed {:,} paths → {:,} unique unitigs, {:,} assignments in {:.1f}s",
        paths_parsed,
        len(unitig_ids),
        len(row_idx),
        elapsed,
    )
    return unitig_ids, row_idx, col_idx


def build_sparse_matrix(
    unitig_ids: Sequence[str],
    row_idx: array,
    col_idx: array,
    sample_count: int,
) -> sparse.csr_matrix:
    logger.info("Building sparse matrix ({:,} unitigs × {:,} samples)", len(unitig_ids), sample_count)
    t0 = time.monotonic()

    if not unitig_ids:
        return sparse.csr_matrix((0, sample_count), dtype=np.uint8)

    row_arr = np.frombuffer(row_idx, dtype=np.uint32).astype(np.int64, copy=False)
    col_arr = np.frombuffer(col_idx, dtype=np.uint32).astype(np.int64, copy=False)
    data = np.ones(row_arr.shape[0], dtype=np.uint8)

    coo = sparse.coo_matrix(
        (data, (row_arr, col_arr)),
        shape=(len(unitig_ids), sample_count),
        dtype=np.uint8,
    )
    csr = coo.tocsr()
    if csr.nnz:
        csr.data.fill(1)

    elapsed = time.monotonic() - t0
    density = csr.nnz / (csr.shape[0] * csr.shape[1]) * 100 if csr.shape[0] else 0
    logger.info(
        "Sparse matrix ready: {:,} nonzeros ({:.1f}% dense) in {:.1f}s",
        csr.nnz,
        density,
        elapsed,
    )
    return csr


_DIGITS = np.array(['0', '1'], dtype='U1')


def write_presence_matrix(
    matrix: sparse.csr_matrix,
    unitig_ids: Sequence[str],
    samples: Sequence[str],
    output_path: Path,
    chunk_size: int,
) -> None:
    logger.info("Writing presence matrix to {}", output_path)
    t0 = time.monotonic()
    output_path.parent.mkdir(parents=True, exist_ok=True)

    n_rows = matrix.shape[0]
    if n_rows == 0:
        with output_path.open("w") as handle:
            handle.write("unitig\t" + "\t".join(samples) + "\n")
        logger.info("Matrix is empty; wrote header only")
        return

    chunk = max(1, chunk_size)
    rows_written = 0

    with output_path.open("w") as handle:
        handle.write("unitig\t" + "\t".join(samples) + "\n")

        for start in range(0, n_rows, chunk):
            stop = min(start + chunk, n_rows)
            dense = matrix[start:stop].toarray()
            local_unitigs = unitig_ids[start:stop]
            for offset, unitig in enumerate(local_unitigs):
                handle.write(unitig)
                handle.write('\t')
                handle.write('\t'.join(_DIGITS[dense[offset]]))
                handle.write('\n')
            rows_written += stop - start
            if rows_written % 50_000 < chunk:
                logger.info(
                    "  written {:,} / {:,} unitig rows ({:.0f}%)",
                    rows_written,
                    n_rows,
                    rows_written / n_rows * 100,
                )

    elapsed = time.monotonic() - t0
    logger.info("Finished writing {:,} rows in {:.1f}s", n_rows, elapsed)


def main(argv: Sequence[str] | None = None) -> None:
    args = parse_args(argv)
    configure_logging(args.verbose)

    samples = load_sample_paths(args.fof)
    unitig_ids, row_idx, col_idx = collect_presence_indices(args.gfa, samples)
    matrix = build_sparse_matrix(unitig_ids, row_idx, col_idx, len(samples))
    write_presence_matrix(matrix, unitig_ids, samples, args.output, args.chunk_size)
    logger.info(
        "Wrote presence/absence matrix to {} ({} unitigs × {} samples, {} ones)",
        args.output,
        matrix.shape[0],
        matrix.shape[1],
        matrix.nnz,
    )


if __name__ == "__main__":
    main()
