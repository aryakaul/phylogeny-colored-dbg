#!/usr/bin/env python3
"""Build a cuttlefish unitig presence/absence matrix for pcDBG."""

from __future__ import annotations

import argparse
import sys
from collections import defaultdict
from pathlib import Path
from typing import Dict, Iterable, List, Sequence, Set

import pandas as pd
from loguru import logger


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=
        "Convert cuttlefish GFA1 output to a unitig presence/absence matrix.")
    parser.add_argument(
        "gfa",
        type=Path,
        help="Path to the cuttlefish-generated GFA1 file.",
    )
    parser.add_argument(
        "fof",
        type=Path,
        help=
        "File-of-filenames enumerating the assemblies used for cuttlefish.",
    )
    parser.add_argument(
        "output",
        type=Path,
        help="Destination TSV file for the presence/absence matrix.",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Increase logging verbosity (specify twice for DEBUG).",
    )
    return parser.parse_args(argv)


def configure_logging(verbosity: int) -> None:
    if verbosity <= 0:
        logger.remove()
    elif verbosity == 1:
        logger.remove()
        logger.add(sys.stderr, level="INFO")
    else:
        logger.remove()
        logger.add(sys.stderr, level="DEBUG")


def load_sample_paths(fof_path: Path) -> List[str]:
    samples: List[str] = []
    with fof_path.open("r") as handle:
        for raw in handle:
            entry = raw.strip()
            if entry:
                samples.append(entry)
    if not samples:
        raise ValueError(
            f"File-of-filenames '{fof_path}' does not contain any entries")
    logger.debug("Loaded {} assemblies from {}", len(samples), fof_path)
    return samples


def parse_gfa_paths(gfa_path: Path,
                    samples: Sequence[str]) -> Dict[str, Set[str]]:
    sample_to_unitigs: Dict[str, Set[str]] = defaultdict(set)

    def strip_orientation(unitig: str) -> str:
        if unitig and unitig[-1] in "+-":
            return unitig[:-1]
        return unitig

    with gfa_path.open("r") as handle:
        for line_number, raw in enumerate(handle, start=1):
            parts = raw.strip().split()
            if not parts or parts[0] != "P":
                continue
            try:
                ref_seq_idx = int(parts[1].split("_")[0].split(":")[1])
            except (IndexError, ValueError) as exc:
                raise ValueError(
                    f"Failed to parse reference index from '{parts[1]}' on line {line_number}"
                ) from exc

            if not (1 <= ref_seq_idx <= len(samples)):
                raise IndexError(
                    f"GFA references sample index {ref_seq_idx}, "
                    f"but only {len(samples)} assemblies were provided")

            sample = samples[ref_seq_idx - 1]
            unitigs = {
                strip_orientation(u)
                for u in parts[2].split(",") if u
            }
            sample_to_unitigs[sample].update(unitigs)

    for sample in samples:
        sample_to_unitigs.setdefault(sample, set())

    logger.debug(
        "Parsed GFA path information for {} samples ({} total unitigs)",
        len(sample_to_unitigs),
        sum(len(unitigs) for unitigs in sample_to_unitigs.values()),
    )
    return sample_to_unitigs


def build_presence_matrix(
    sample_to_unitigs: Dict[str, Set[str]],
    samples: Sequence[str],
) -> pd.DataFrame:
    all_unitigs = sorted({
        unitig
        for unitigs in sample_to_unitigs.values()
        for unitig in unitigs
    })
    logger.debug("Constructing presence/absence matrix with {} unitigs",
                 len(all_unitigs))

    if not all_unitigs:
        # No unitigs observed; return an empty frame with requested columns.
        return pd.DataFrame(0, index=[], columns=list(samples), dtype=int)

    df = pd.DataFrame(
        0,
        index=all_unitigs,
        columns=list(samples),
        dtype=int,
    )

    for sample, unitigs in sample_to_unitigs.items():
        if not unitigs:
            continue
        df.loc[list(unitigs), sample] = 1

    return df


def main(argv: Sequence[str] | None = None) -> None:
    args = parse_args(argv)
    configure_logging(args.verbose)

    samples = load_sample_paths(args.fof)
    sample_to_unitigs = parse_gfa_paths(args.gfa, samples)
    matrix = build_presence_matrix(sample_to_unitigs, samples)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    matrix.to_csv(args.output, sep="\t")
    logger.info("Wrote presence/absence matrix to {}", args.output)


if __name__ == "__main__":
    main()
