#!/usr/bin/env python3
"""Compute minimal parsimony cuts for unitig presence/absence patterns.

For each unique presence/absence vector (leaf set), performs Sankoff or Fitch
parsimony on the phylogenetic tree and reports the minimal set of edges where
the ancestral state changes — i.e., the "cuts" separating present (red) from
absent (blue) clades.

Optimization notes
------------------
- Pool initializer pattern: The tree, model, and known_leaves are loaded once
  per worker process via multiprocessing.Pool(initializer=...) rather than being
  pickled with every chunk. This avoids O(n_chunks) serializations of the Tree.
- Chunk size trade-off: Larger chunks reduce IPC overhead but increase per-worker
  memory. The default of 5000 balances throughput and memory for typical datasets.
- The DP tree (NodeDP) is rebuilt from scratch for each leaf set. Caching the tree
  topology and only swapping leaf costs was considered but not implemented because
  NodeDP construction is lightweight for trees under ~10k nodes, and the rebuild
  keeps the code simple with no shared mutable state between leaf sets.
"""

from __future__ import annotations

import argparse
import gzip
import math
import multiprocessing
import os
import statistics
import sys
import time
from dataclasses import dataclass
from datetime import datetime
from typing import Dict, Iterable, Iterator, List, Tuple

import ete4
from ete4 import Tree
from loguru import logger

STATES: Tuple[str, str] = ("present", "absent")
INF = float("inf")
EPS = 1e-9

# Module-level globals set by _init_worker for multiprocessing.
# Each worker process gets its own copy via the Pool initializer,
# avoiding repeated pickling of the tree with every chunk.
_worker_tree: Tree = None  # type: ignore[assignment]
_worker_model: "ParsimonyModel" = None  # type: ignore[assignment]
_worker_known_leaves: set[str] = set()
_worker_all_leaf_coloring: bool = False
_worker_verbosity: int = 0


@dataclass
class NodeDP:
    """Dynamic programming node mirroring the phylogeny during parsimony.

    Stores the optimal cost to assign each state at this node, and the
    corresponding best child-state choices that achieve that cost.
    """
    node: Tree
    children: List["NodeDP"]
    cost_by_state: Dict[str, float]
    child_state_options: Dict[str, List[List[str]]]


@dataclass
class ParsimonySolution:
    """One optimal parsimony reconstruction for a leaf set.

    Attributes:
        root_state: The state assigned to the root ("present" or "absent").
        cuts: Node names where the state changes from parent to child.
        colors: Mapping of node name -> assigned state for all named nodes.
    """
    root_state: str
    cuts: List[str]
    colors: Dict[str, str]


class ParsimonyModel:
    """Base class for parsimony transition cost models."""
    name = "base"

    def edge_cost(self, parent_state: str, child_state: str,
                  child_node: Tree) -> float:
        raise NotImplementedError


class FitchModel(ParsimonyModel):
    """Unit-cost (Fitch) parsimony: every state change costs 1."""
    name = "fitch"

    def edge_cost(self, parent_state: str, child_state: str,
                  child_node: Tree) -> float:
        return 0.0 if parent_state == child_state else 1.0


class SankoffModel(ParsimonyModel):
    """Branch-length-weighted (Sankoff) parsimony.

    The cost of a state change on an edge is branch_penalty * branch_length.
    """
    name = "sankoff"

    def __init__(self, branch_penalty: float, fallback_length: float):
        self.branch_penalty = branch_penalty
        self.fallback_length = fallback_length

    def edge_cost(self, parent_state: str, child_state: str,
                  child_node: Tree) -> float:
        if parent_state == child_state:
            return 0.0
        length = child_node.dist
        if length is None or length <= 0:
            length = self.fallback_length
        return self.branch_penalty * length


def _count_leaf_sets(file_path: str) -> int:
    """Count non-empty lines in the leaves file (one leaf set per line)."""
    count = 0
    with open(file_path, "r") as handle:
        for line in handle:
            if line.strip():
                count += 1
    return count


def read_target_leaves(file_path: str,
                       chunk_size: int) -> Iterator[List[set[str]]]:
    """Yield chunks of leaf sets from the leaves file.

    Each line is whitespace-split into a set of leaf names. Lines are batched
    into lists of ``chunk_size`` for parallel processing.
    """

    def generate_chunks() -> Iterator[List[set[str]]]:
        with open(file_path, "r") as handle:
            chunk: List[set[str]] = []
            for line in handle:
                stripped = line.strip()
                if not stripped:
                    continue
                chunk.append(set(stripped.split()))
                if len(chunk) == chunk_size:
                    yield chunk
                    chunk = []
            if chunk:
                yield chunk

    return generate_chunks()


def autocomplete_internal_node_names(tree: Tree, newtreefile: str) -> Tree:
    """Assign names to unnamed internal nodes based on their children.

    Names follow the pattern ``<child_name>-up1``, ``<child_name>-up2``, etc.,
    incrementing from the alphabetically first child name.
    """
    import re

    logger.info("Autocompleting internal node names")

    re_inferred = re.compile(r"^(.*)-up(\d+)$")
    renamed_nodes = False
    for node in tree.traverse("postorder"):
        if node.is_leaf:
            continue
        if not node.name:
            child_names = [child.name for child in node.children if child.name]
            if not child_names:
                continue
            candidate = sorted(child_names)[0]
            match = re_inferred.match(candidate)
            if match is not None:
                label, idx = match.groups()
                node.name = f"{label}-up{int(idx) + 1}"
            else:
                node.name = f"{candidate}-up1"
            renamed_nodes = True
            logger.debug("Named internal node {}", node.name)

    if renamed_nodes:
        logger.info("Writing renamed tree to {}", newtreefile)
        tree.write(parser=1, outfile=newtreefile)
    return tree


def build_dynamic_programming_tree(node: Tree, target_leaves: set[str],
                                   model: ParsimonyModel) -> NodeDP:
    """Build the Sankoff/Fitch DP tree via post-order traversal.

    Leaves are constrained to "present" if in target_leaves, "absent"
    otherwise (infinite cost for the wrong state). Internal nodes accumulate
    the minimum cost over children for each possible state assignment.
    """
    if node.is_leaf:
        cost_by_state = {
            "present": 0.0 if node.name in target_leaves else INF,
            "absent": 0.0 if node.name not in target_leaves else INF,
        }
        child_state_options = {state: [] for state in STATES}
        return NodeDP(node=node,
                      children=[],
                      cost_by_state=cost_by_state,
                      child_state_options=child_state_options)

    child_dps = [
        build_dynamic_programming_tree(child, target_leaves, model)
        for child in node.children
    ]

    cost_by_state: Dict[str, float] = {}
    child_state_options: Dict[str, List[List[str]]] = {}

    for parent_state in STATES:
        total_cost = 0.0
        options_per_child: List[List[str]] = []
        feasible = True

        for child_dp in child_dps:
            best_cost = INF
            best_states: List[str] = []

            for child_state in STATES:
                child_cost = child_dp.cost_by_state.get(child_state, INF)
                if math.isinf(child_cost):
                    continue
                edge_cost = model.edge_cost(parent_state, child_state,
                                            child_dp.node)
                combined = child_cost + edge_cost

                if combined + EPS < best_cost:
                    best_cost = combined
                    best_states = [child_state]
                elif abs(combined - best_cost) <= EPS:
                    best_states.append(child_state)

            if not best_states:
                feasible = False
                options_per_child.append([])
                total_cost = INF
            else:
                options_per_child.append(best_states)
                total_cost += best_cost

        if not feasible:
            cost_by_state[parent_state] = INF
        else:
            cost_by_state[parent_state] = total_cost

        child_state_options[parent_state] = options_per_child

    return NodeDP(node=node,
                  children=child_dps,
                  cost_by_state=cost_by_state,
                  child_state_options=child_state_options)


def _select_child_state(child_dp: NodeDP, allowed_states: List[str]) -> str:
    """Pick the lowest-cost child state, breaking ties alphabetically."""
    if not allowed_states:
        raise ValueError("No feasible child states available during trace")
    best_cost = min(child_dp.cost_by_state[state] for state in allowed_states)
    candidates = [
        state for state in allowed_states
        if abs(child_dp.cost_by_state[state] - best_cost) <= EPS
    ]
    candidates.sort()
    return candidates[0]


def trace_solution(node_dp: NodeDP, parent_state: str) -> ParsimonySolution:
    """Trace back through the DP tree to recover state assignments and cuts.

    Starting from the root with ``parent_state``, greedily selects the
    lowest-cost child state at each internal node. An edge where the state
    changes is recorded as a "cut".
    """
    assignments: Dict[str, str] = {}
    cuts: List[str] = []

    def _trace(current_dp: NodeDP, current_state: str) -> None:
        node = current_dp.node
        if node.name:
            assignments[node.name] = current_state

        child_options = current_dp.child_state_options[current_state]
        for idx, child_dp in enumerate(current_dp.children):
            allowed_states = child_options[idx] if idx < len(
                child_options) else []
            if not allowed_states:
                continue
            child_state = _select_child_state(child_dp, allowed_states)
            _trace(child_dp, child_state)
            if node.name and child_dp.node.name and child_state != current_state:
                cuts.append(child_dp.node.name)

    _trace(node_dp, parent_state)

    filtered_cuts = [cut for cut in cuts if cut]
    if not filtered_cuts:
        filtered_cuts = ["Root"]

    return ParsimonySolution(root_state=parent_state,
                             cuts=filtered_cuts,
                             colors=dict(assignments))


def run_parsimony(tree: Tree, target_leaves: set[str], model: ParsimonyModel,
                  known_leaves: set[str]) -> List[ParsimonySolution]:
    """Run parsimony for one leaf set, returning all optimal solutions.

    Filters out target leaves not present in the tree, builds the DP tree,
    and traces back all root states that achieve the minimum cost.
    """
    missing = target_leaves.difference(known_leaves)
    if missing:
        preview = ", ".join(sorted(missing)[:5])
        suffix = "..." if len(missing) > 5 else ""
        logger.warning(
            "Ignoring {:,} target leaves absent from tree: {}{}",
            len(missing),
            preview,
            suffix,
        )
        target_leaves = target_leaves.intersection(known_leaves)

    dp_root = build_dynamic_programming_tree(tree, target_leaves, model)
    min_cost = min(dp_root.cost_by_state.values())
    if math.isinf(min_cost):
        logger.error("No feasible solution for leaf set {}", target_leaves)
        return []

    solutions: List[ParsimonySolution] = []
    for state in STATES:
        if abs(dp_root.cost_by_state[state] - min_cost) <= EPS:
            solution = trace_solution(dp_root, state)
            solutions.append(solution)

    return solutions


def process_chunk(tree: Tree, chunk_data: List[set[str]],
                  all_leaf_coloring: bool, model: ParsimonyModel,
                  known_leaves: set[str]) -> Tuple[List[object], List[tuple]]:
    """Process a batch of leaf sets, returning cuts and optional colorings."""
    results: List[object] = []
    colors_info: List[tuple] = []

    for idx, leaf_set in enumerate(chunk_data):
        logger.debug("Processing leaf set {} ({} leaves)", idx, len(leaf_set))
        start = time.time()
        solutions = run_parsimony(tree, set(leaf_set), model, known_leaves)

        if not solutions:
            results.append(["Root"])
            if all_leaf_coloring:
                colors_info.append((idx, "infeasible", {}))
            continue

        if len(solutions) == 1:
            cuts_payload = list(solutions[0].cuts)
            results.append(cuts_payload if cuts_payload else ["Root"])
            if all_leaf_coloring:
                colors_info.append(
                    (idx, solutions[0].root_state, dict(solutions[0].colors)))
        else:
            cuts_options = tuple(
                list(sol.cuts) if sol.cuts else ["Root"] for sol in solutions)
            results.append(cuts_options)
            if all_leaf_coloring:
                colors_info.append(
                    (idx, "ambiguous",
                     tuple(dict(sol.colors) for sol in solutions)))

        elapsed = time.time() - start
        logger.debug("Processed leaf set {} in {:.2f}s", idx, elapsed)

    return results, colors_info


def _init_worker(tree: Tree, model: ParsimonyModel, known_leaves: set[str],
                 all_leaf_coloring: bool, verbosity: int) -> None:
    """Initializer for multiprocessing.Pool workers.

    Stores the tree, model, and known_leaves as module-level globals so they
    are pickled once (at pool creation) rather than with every chunk.
    Also configures the logger in the worker process to match the main process.
    """
    global _worker_tree, _worker_model, _worker_known_leaves, _worker_all_leaf_coloring
    _worker_tree = tree
    _worker_model = model
    _worker_known_leaves = known_leaves
    _worker_all_leaf_coloring = all_leaf_coloring
    _configure_logger(verbosity)


def _process_chunk_worker(
        chunk_data: List[set[str]]) -> Tuple[List[object], List[tuple]]:
    """Worker target that uses module-level globals set by _init_worker."""
    return process_chunk(_worker_tree, chunk_data, _worker_all_leaf_coloring,
                         _worker_model, _worker_known_leaves)


def minimal_cuts_for_all_sets(
        tree: Tree,
        leaves_file_path: str,
        chunk_size: int,
        num_threads: int,
        model: ParsimonyModel,
        known_leaves: set[str],
        all_leaf_coloring: bool = False,
        verbosity: int = 0) -> Tuple[List[object], List[tuple]]:
    """Run parsimony on all leaf sets from the leaves file.

    Reads leaf sets in chunks, dispatches them to worker processes (or runs
    single-threaded), and aggregates results. Logs progress at INFO level.
    """
    total_sets = _count_leaf_sets(leaves_file_path)
    total_chunks = math.ceil(total_sets / chunk_size) if chunk_size > 0 else 1
    logger.info(
        "Processing {:,} leaf sets in {:,} chunks of {:,} (threads={})",
        total_sets, total_chunks, chunk_size, num_threads)

    results: List[object] = []
    colors_info: List[tuple] = []
    sets_done = 0
    chunks_done = 0
    t_start = time.time()

    def _log_chunk_progress(chunk_size_actual: int) -> None:
        nonlocal sets_done, chunks_done
        sets_done += chunk_size_actual
        chunks_done += 1
        elapsed = time.time() - t_start
        pct = sets_done / total_sets * 100 if total_sets > 0 else 100
        rate = sets_done / elapsed if elapsed > 0 else 0
        logger.info(
            "Chunk {}/{} done — {:,}/{:,} leaf sets ({:.0f}%) "
            "[{:.1f}s elapsed, {:.0f} sets/s]", chunks_done, total_chunks,
            sets_done, total_sets, pct, elapsed, rate)

    def _chunk_iter() -> Iterator[List[set[str]]]:
        for chunk in read_target_leaves(leaves_file_path, chunk_size):
            yield chunk

    if num_threads <= 1:
        for chunk_data in _chunk_iter():
            chunk_results, chunk_colors = process_chunk(
                tree, chunk_data, all_leaf_coloring, model, known_leaves)
            results.extend(chunk_results)
            if all_leaf_coloring:
                colors_info.extend(chunk_colors)
            _log_chunk_progress(len(chunk_data))
    else:
        with multiprocessing.Pool(num_threads,
                                  initializer=_init_worker,
                                  initargs=(tree, model, known_leaves,
                                            all_leaf_coloring,
                                            verbosity)) as pool:
            for chunk_results, chunk_colors in pool.imap_unordered(
                    _process_chunk_worker, _chunk_iter()):
                results.extend(chunk_results)
                if all_leaf_coloring:
                    colors_info.extend(chunk_colors)
                _log_chunk_progress(len(chunk_results))

    elapsed_total = time.time() - t_start
    rate = total_sets / elapsed_total if elapsed_total > 0 else 0
    logger.info(
        "Parsimony complete: {:,} leaf sets in {:.1f}s ({:.0f} sets/s)",
        total_sets, elapsed_total, rate)

    return results, colors_info if all_leaf_coloring else []


def plot_tree_and_colors(tree: Tree, color_dict: Dict[str, str],
                         output: str) -> None:
    """Render the tree with red/blue node coloring to an SVG file."""
    os.environ["QT_QPA_PLATFORM"] = "offscreen"
    logger.debug("Saving tree to {}", output)

    working_tree = tree.copy(method="deepcopy")
    ts = ete4.TreeStyle()

    def label_nodes(node: Tree) -> None:
        node_color = "#000000"
        state = color_dict.get(node.name)
        if state == "present":
            node_color = "#FF0000"
        elif state == "absent":
            node_color = "#0000FF"

        node.img_style["hz_line_color"] = node_color
        node.img_style["vt_line_color"] = node_color
        node.img_style["size"] = 10
        node.img_style["fgcolor"] = node_color

        if node.is_leaf:
            face = ete4.faces.TextFace(node.name, tight_text=False, fsize=10)
            node.add_face(face, column=0, position="aligned")
            rect_face = ete4.faces.RectFace(width=10,
                                            height=10,
                                            fgcolor=node_color,
                                            bgcolor=node_color)
            node.add_face(rect_face, column=1, position="aligned")

    ts.show_leaf_name = False

    def custom_layout(node: Tree) -> None:
        label_nodes(node)

    ts.layout_fn = custom_layout
    ts.draw_guiding_lines = True
    working_tree.render(output, tree_style=ts)


def _configure_logger(verbosity: int) -> None:
    """Set up loguru with the requested verbosity level.

    -v=0: WARNING only, -v=1: INFO, -v>=2: DEBUG.
    """
    logger.remove()
    if verbosity == 0:
        logger.add(sys.stderr, level="WARNING")
    elif verbosity == 1:
        logger.add(sys.stderr, level="INFO")
    else:
        logger.add(sys.stderr, level="DEBUG")


def _derive_default_branch_penalty(tree: Tree) -> Tuple[float, float]:
    """Compute a data-driven Sankoff branch penalty from mean branch length."""
    lengths = [
        node.dist for node in tree.traverse("postorder")
        if node.up is not None and node.dist is not None and node.dist > 0
    ]
    if not lengths:
        return 1.0, 1.0
    mean_length = statistics.mean(lengths)
    penalty = 1.0 / mean_length if mean_length > 0 else 1.0
    return penalty, mean_length


def main() -> None:
    parser = argparse.ArgumentParser(
        description=
        "Compute minimal cuts for unitig presence/absence parsimony.")
    parser.add_argument("tree_file",
                        type=str,
                        help="Path to the Newick formatted tree file.")
    parser.add_argument(
        "leaves_file",
        type=str,
        help="Path to the file containing target (red) leaves.")
    parser.add_argument(
        "--all",
        dest="all_solutions",
        action="store_true",
        help="Emit all optimal root-state solutions when ties occur.",
    )
    parser.add_argument(
        "-t",
        "--tree",
        type=str,
        default=
        f"./minimalcuts_fullynamedtree_{datetime.now().strftime('%Y-%m-%d-%H:%M:%S')}.nwk",
        help=("Path to write a renamed tree if internal nodes are unnamed. "
              "Only used when renaming is required."),
    )
    parser.add_argument(
        "-o",
        "--output",
        type=str,
        default=None,
        help="Path to output file. Defaults to stdout.",
    )
    parser.add_argument(
        "-c",
        "--colors",
        type=str,
        default=None,
        help=("If specified, also write node colors for each leaf subset "
              "to this file."),
    )
    parser.add_argument(
        "-p",
        "--plot",
        dest="plot",
        type=str,
        default=None,
        help="Plot solutions using ete4 and save plots to the given directory.",
    )
    parser.add_argument(
        "-j",
        "--threads",
        default=multiprocessing.cpu_count(),
        type=int,
        help="Number of worker processes to use. Default uses all cores.",
    )
    parser.add_argument(
        "-cs",
        "--chunksize",
        default=5000,
        type=int,
        help="Number of leaf sets to analyse per batch.",
    )
    parser.add_argument(
        "-m",
        "--mode",
        choices=("fitch", "sankoff"),
        default="fitch",
        help="Parsimony model to use for minimal cuts.",
    )
    parser.add_argument(
        "--branch-penalty",
        type=float,
        default=None,
        help=("Per-unit change penalty for Sankoff mode. "
              "If omitted, a data-driven default is computed."),
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Increase verbosity. Repeat for more detailed logs.",
    )

    args = parser.parse_args()

    _configure_logger(args.verbose)

    with open(args.tree_file, "r") as handle:
        tree = Tree(handle, parser=1)

    if not tree.name:
        tree.name = "Root"

    unnamed_internal = [
        node for node in tree.traverse("postorder")
        if not node.is_leaf and not node.name
    ]
    if unnamed_internal:
        logger.info("Detected {} unnamed internal nodes; autocompleting.",
                    len(unnamed_internal))
        tree = autocomplete_internal_node_names(tree, args.tree)

    known_leaves = {
        node.name
        for node in tree.traverse("postorder") if node.is_leaf and node.name
    }
    logger.info("Tree loaded: {:,} leaves", len(known_leaves))

    if args.mode == "fitch":
        model: ParsimonyModel = FitchModel()
        logger.info("Using Fitch parsimony (unit cost transitions).")
    else:
        default_penalty, mean_length = _derive_default_branch_penalty(tree)
        branch_penalty = args.branch_penalty or default_penalty
        logger.info(
            "Using Sankoff parsimony with branch penalty {:.6f} "
            "(mean branch length {:.6f}).", branch_penalty, mean_length)
        model = SankoffModel(branch_penalty=branch_penalty,
                             fallback_length=mean_length or 1.0)

    results, colors = minimal_cuts_for_all_sets(tree,
                                                args.leaves_file,
                                                args.chunksize,
                                                args.threads,
                                                model,
                                                known_leaves,
                                                all_leaf_coloring=bool(
                                                    args.colors),
                                                verbosity=args.verbose)

    logger.info("Writing minimal cuts to {}", args.output or "stdout")
    if args.output:
        writer = open(args.output, "w")
    else:
        writer = sys.stdout

    try:
        for result in results:
            if isinstance(result, tuple):
                first = ",".join(result[0])
                if args.all_solutions and len(result) > 1:
                    second = ",".join(result[1])
                    writer.write(f"{first} OR {second}\n")
                else:
                    writer.write(f"{first}\n")
            else:
                writer.write(",".join(result) + "\n")
    finally:
        if args.output:
            writer.close()

    if args.colors:
        logger.info("Writing node colours to {}", args.colors)
        opener = gzip.open if args.colors.endswith(".gz") else open
        with opener(args.colors, "wt") as handle:
            has_ambiguous = any(
                isinstance(entry[2], tuple) for entry in colors)
            if has_ambiguous and args.all_solutions:
                handle.write("leaf_set_idx\tsolution\tnode\tstate\n")
            else:
                handle.write("leaf_set_idx\tnode\tstate\n")

            for global_idx, entry in enumerate(colors):
                color_payload = entry[2]
                if isinstance(color_payload, tuple):
                    if args.all_solutions:
                        for sol_idx, mapping in enumerate(color_payload):
                            for node_name, state in sorted(mapping.items()):
                                handle.write(
                                    f"{global_idx}\t{sol_idx}\t{node_name}\t{state}\n"
                                )
                    else:
                        for node_name, state in sorted(
                                color_payload[0].items()):
                            handle.write(
                                f"{global_idx}\t{node_name}\t{state}\n")
                elif isinstance(color_payload, dict):
                    if has_ambiguous and args.all_solutions:
                        for node_name, state in sorted(color_payload.items()):
                            handle.write(
                                f"{global_idx}\t0\t{node_name}\t{state}\n")
                    else:
                        for node_name, state in sorted(color_payload.items()):
                            handle.write(
                                f"{global_idx}\t{node_name}\t{state}\n")


if __name__ == "__main__":
    main()
