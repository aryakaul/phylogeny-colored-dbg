#!/usr/bin/env python3
"""Translate deletion bubble path pairs into FASTA sequences."""

from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from pathlib import Path
from typing import Dict, Iterable, List, Sequence, Tuple

from loguru import logger

from sql_utils import lookup_unitig_sequences

DNA_COMPLEMENT = str.maketrans("ACGTacgtnN", "TGCAtgcanN")


def parse_args(argv: Sequence[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=
        "Convert BubbleGun deletion bubble paths into FASTA sequences.")
    parser.add_argument(
        "-b",
        "--bubblegun",
        type=Path,
        required=True,
        help="JSON file produced by find_colored_deletions.",
    )
    parser.add_argument(
        "-d",
        "--db",
        type=Path,
        required=True,
        help="SQLite database generated by gfa_to_sql.",
    )
    parser.add_argument(
        "-k",
        "--kmer-length",
        type=int,
        required=True,
        help="k-mer length used during cuttlefish graph construction.",
    )
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        required=True,
        help="Output directory for FASTA files.",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="Increase logging verbosity (specify twice for DEBUG).",
    )
    return parser.parse_args(argv)


def configure_logging(verbosity: int) -> None:
    if verbosity <= 0:
        logger.remove()
    elif verbosity == 1:
        logger.remove()
        logger.add(sys.stderr, level="INFO")
    else:
        logger.remove()
        logger.add(sys.stderr, level="DEBUG")


def load_bubbles(bubble_path: Path) -> List[Dict[str, object]]:
    with bubble_path.open("r") as handle:
        data = json.load(handle)
    logger.debug("Loaded {} bubbles from {}", len(data), bubble_path)
    return data


def reverse_complement(sequence: str) -> str:
    return sequence.translate(DNA_COMPLEMENT)[::-1]


def orient_sequence(sequence: str, orientation: str) -> str:
    if orientation == "+":
        return sequence
    if orientation == "-":
        return reverse_complement(sequence)
    raise ValueError(f"Unexpected orientation flag '{orientation}'")


def assemble_path(
    path: Sequence[str],
    sequences: Dict[str, str],
    kmer_length: int,
) -> str:
    assembled: List[str] = []
    for index, oriented_unitig in enumerate(path):
        unitig_id = oriented_unitig[:-1]
        orientation = oriented_unitig[-1]
        if unitig_id not in sequences:
            raise KeyError(f"Sequence missing for unitig '{unitig_id}'")
        seq = orient_sequence(sequences[unitig_id], orientation)
        if index == 0:
            assembled.append(seq)
        else:
            assembled.append(seq[kmer_length - 1:])
    return "".join(assembled)


def unitig_ids_from_pairs(path_pairs: Iterable[Sequence[str]]) -> List[str]:
    unique_ids = []
    seen = set()
    for path in path_pairs:
        for oriented in path:
            unitig_id = oriented[:-1]
            if unitig_id not in seen:
                seen.add(unitig_id)
                unique_ids.append(unitig_id)
    return unique_ids


def export_bubble_sequences(
    conn: sqlite3.Connection,
    bubbles: Sequence[Dict[str, object]],
    output_dir: Path,
    kmer_length: int,
) -> int:
    output_dir.mkdir(parents=True, exist_ok=True)
    written = 0

    for bubble in bubbles:
        path_pairs = bubble.get("valid_path_pairs") or []
        if not path_pairs:
            logger.debug("Skipping bubble {} (no valid path pairs)",
                         bubble.get("id"))
            continue

        bubble_id = str(bubble.get("id"))
        unitig_ids = unitig_ids_from_pairs(path for pair in path_pairs
                                           for path in pair)
        sequences = lookup_unitig_sequences(conn, unitig_ids)
        missing = set(unitig_ids) - sequences.keys()
        if missing:
            logger.warning(
                "Bubble {} skips {} unitigs missing sequences in the database",
                bubble_id,
                len(missing),
            )
            continue

        for pair_index, (post_path, pre_path) in enumerate(path_pairs,
                                                           start=1):
            try:
                post_sequence = assemble_path(post_path, sequences,
                                              kmer_length)
                pre_sequence = assemble_path(pre_path, sequences, kmer_length)
            except KeyError as exc:
                logger.warning(
                    "Skipping bubble {} pair {} due to missing sequence: {}",
                    bubble_id,
                    pair_index,
                    exc,
                )
                continue

            fasta_path = output_dir / f"{bubble_id}_pair{pair_index:03d}.fasta"
            with fasta_path.open("w") as handle:
                handle.write(
                    f">{bubble_id}|pair{pair_index}|post\n{post_sequence}\n")
                handle.write(
                    f">{bubble_id}|pair{pair_index}|pre\n{pre_sequence}\n")
            written += 1
    return written


def main(argv: Sequence[str] | None = None) -> None:
    args = parse_args(argv)
    configure_logging(args.verbose)

    if args.kmer_length < 1:
        raise ValueError("k-mer length must be positive")

    bubbles = load_bubbles(args.bubblegun)
    if not bubbles:
        logger.warning("No bubbles present in {}; nothing to do",
                       args.bubblegun)
        return

    with sqlite3.connect(args.db) as conn:
        fasta_count = export_bubble_sequences(conn, bubbles, args.output,
                                              args.kmer_length)
    logger.info("Wrote {} FASTA files to {}", fasta_count, args.output)


if __name__ == "__main__":
    main()
